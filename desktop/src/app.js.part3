function selectChannel(id){const c=state.selectedServer?.channels.find(x=>x.id===id);if(!c)return;state.selectedChannel=c;els.emptyView.classList.add('hidden');renderChannels();els.channelName.textContent=c.name;if(c.type==='text'){els.channelIcon.textContent='#';els.channelDesc.textContent='Conversa do servidor';els.textView.classList.remove('hidden');els.voiceView.classList.add('hidden');state.socket.emit('messages:load',{serverId:state.selectedServer.id,channelId:c.id});setTimeout(()=>els.messageInput.focus(),0)}else{els.channelIcon.textContent='🔊';els.channelDesc.textContent='Canal de voz';els.textView.classList.add('hidden');els.voiceView.classList.remove('hidden');els.voiceTitle.textContent=c.name;updateVoiceUI()}}
function renderMembers(){els.memberList.innerHTML='';const arr=[...state.members.values()].sort((a,b)=>(b.status==='online')-(a.status==='online')||(ROLE_RANK[b.role||'member']-ROLE_RANK[a.role||'member'])||a.name.localeCompare(b.name));for(const u of arr){const role=u.role||roleFor(u.id);const row=document.createElement('div');row.className='member'+(u.status==='offline'?' offline':'');const av=document.createElement('div');av.className='avatar';avatarStyle(av,u);const tx=document.createElement('div');tx.className='member-name';tx.innerHTML=`<b class="role-color-${role}">${escapeHtml(u.name)}${role==='owner'?' 👑':''}</b><small><span class="status-dot status-${escapeHtml(u.status||'offline')}"></span>${STATUS_LABEL[u.status||'offline']||'Offline'} · <span class="role-badge role-${role}">${ROLE_LABEL[role]}</span></small>`;row.append(av,tx);row.title='Ver perfil';row.addEventListener('click',()=>openMemberProfile(u.id));els.memberList.appendChild(row)}}
function renderMessages(forceBottom=false){if(!state.selectedChannel||state.selectedChannel.type!=='text')return;const wasBottom=els.messages.scrollHeight-els.messages.scrollTop-els.messages.clientHeight<90;els.messages.innerHTML='';for(const m of state.messagesByChannel.get(state.selectedChannel.id)||[]){const u=state.members.get(m.authorId)||{name:'Usuário'};const role=u.role||roleFor(m.authorId);const row=document.createElement('div');row.className='message';const av=document.createElement('div');av.className='avatar';avatarStyle(av,u);const body=document.createElement('div');body.innerHTML=`<div class="msg-head"><b class="role-color-${role}">${escapeHtml(u.name)}</b><small>${fmtTime(m.at)}</small></div><div class="msg-text">${escapeHtml(m.text)}</div>`;row.append(av,body);els.messages.appendChild(row)}if(forceBottom||wasBottom)els.messages.scrollTop=els.messages.scrollHeight}

els.messageForm.addEventListener('submit',e=>{e.preventDefault();const text=els.messageInput.value.trim();if(!text||!state.selectedServer||state.selectedChannel?.type!=='text')return;state.socket.emit('message:send',{serverId:state.selectedServer.id,channelId:state.selectedChannel.id,text});els.messageInput.value=''});
els.addServerBtn.addEventListener('click',()=>openModal(`<h2>Servidor</h2><p>Crie um servidor privado ou entre com o código de um servidor deste mesmo host.</p><label>Nome do novo servidor</label><input id="newServerName" maxlength="40" placeholder="Banana Gang"><button id="createServerNow">Criar servidor</button><div class="divider"><span>ou</span></div><label>Código de convite</label><input id="joinCode" maxlength="16" placeholder="A1B2C3D4"><button id="joinServerNow">Entrar pelo código</button>`));
els.modalBody.addEventListener('click',e=>{if(e.target.id==='createServerNow'){const name=$('newServerName')?.value.trim();if(name)state.socket.emit('server:create',{name})}if(e.target.id==='joinServerNow'){const inviteCode=$('joinCode')?.value.trim();if(inviteCode)state.socket.emit('server:join',{inviteCode})}});
function channelModal(type){openModal(`<h2>Novo canal ${type==='voice'?'de voz':'de texto'}</h2><label>Nome</label><input id="newChannelName" maxlength="32" placeholder="${type==='voice'?'Jogando':'jogos'}"><button id="createChannelNow">Criar canal</button>`);$('createChannelNow').addEventListener('click',()=>{const name=$('newChannelName').value.trim();if(name){state.socket.emit('channel:create',{serverId:state.selectedServer.id,type,name});closeModal()}})}
function editChannelModal(c){openModal(`<h2>Editar canal</h2><label>Nome</label><input id="editChannelName" maxlength="32" value="${escapeHtml(c.name)}"><button id="saveChannelName">Salvar nome</button><hr class="settings-sep"><button id="deleteChannel" class="danger-action">Excluir canal</button><p><small>Você pode arrastar canais na lateral para reordená-los.</small></p>`);$('saveChannelName').onclick=()=>{const name=$('editChannelName').value.trim();if(name)state.socket.emit('channel:update',{serverId:state.selectedServer.id,channelId:c.id,name});closeModal()};$('deleteChannel').onclick=()=>{if(confirm(`Excluir #${c.name}?`)){state.socket.emit('channel:update',{serverId:state.selectedServer.id,channelId:c.id,action:'delete'});closeModal()}}}
els.inviteBtn.addEventListener('click',openInviteModal);async function openInviteModal(){if(!state.selectedServer)return;const url=state.isHost?(state.publicHostUrl||state.serverUrl):state.serverUrl;const full=makeInvite(url,state.selectedServer.inviteCode);openModal(`<h2>Convidar para ${escapeHtml(state.selectedServer.name)}</h2><p>Seu amigo instala o Banana Cord e cola este convite na primeira tela:</p><div class="invite-box">${escapeHtml(full)}</div><button id="copyInvite">Copiar convite</button><p><small>Código: <b>${escapeHtml(state.selectedServer.inviteCode)}</b></small></p>${can('admin')?'<button id="regenInvite" class="secondary">Gerar novo código</button>':''}`);$('copyInvite').onclick=copyCurrentInvite;if($('regenInvite'))$('regenInvite').onclick=()=>state.socket.emit('server:regenerate-invite',{serverId:state.selectedServer.id})}
async function copyCurrentInvite(){if(!state.selectedServer)return;const url=state.isHost?(state.publicHostUrl||state.serverUrl):state.serverUrl;await ipcRenderer.invoke('clipboard:write',makeInvite(url,state.selectedServer.inviteCode));toast('Convite copiado.');closeModal()}
els.serverSettingsBtn.addEventListener('click',openServerSettings);
function openServerSettings(){if(!state.selectedServer)return;const s=state.selectedServer;const r=currentRole();const rows=[...state.members.values()].map(u=>{const role=u.role||roleFor(u.id);const canEdit=r==='owner'&&u.id!==s.ownerId;return `<div class="role-row"><div class="avatar role-avatar" data-user="${escapeHtml(u.id)}"></div><div><b>${escapeHtml(u.name)}</b><small>${STATUS_LABEL[u.status||'offline']||'Offline'}</small></div>${canEdit?`<select class="role-select" data-user="${escapeHtml(u.id)}"><option value="member" ${role==='member'?'selected':''}>Membro</option><option value="moderator" ${role==='moderator'?'selected':''}>Moderador</option><option value="admin" ${role==='admin'?'selected':''}>Administrador</option></select><button class="remove-member" data-user="${escapeHtml(u.id)}">Remover</button>`:`<span class="role-badge role-${role}">${ROLE_LABEL[role]}</span><span></span>`}</div>`}).join('');openModal(`<h2>${escapeHtml(s.name)}</h2><div class="server-settings-grid">${can('admin')?`<label>Nome do servidor</label><input id="serverNameEdit" maxlength="40" value="${escapeHtml(s.name)}"><button id="saveServerName">Salvar nome</button>`:''}<div class="permission-note"><b>Cargos</b><br>Dono: tudo. Administrador: servidor, convites e canais. Moderador: criar, editar, apagar e ordenar canais. Membro: conversa e entra nas calls.</div><div class="role-table">${rows||'<p>Carregando membros…</p>'}</div><div class="version-label">Banana Cord v0.9</div></div>`);for(const el of document.querySelectorAll('.role-avatar'))avatarStyle(el,state.members.get(el.dataset.user));$('saveServerName')?.addEventListener('click',()=>{state.socket.emit('server:update',{serverId:s.id,name:$('serverNameEdit').value});closeModal()});for(const sel of document.querySelectorAll('.role-select'))sel.addEventListener('change',()=>state.socket.emit('member:set-role',{serverId:s.id,userId:sel.dataset.user,role:sel.value}));for(const b of document.querySelectorAll('.remove-member'))b.addEventListener('click',()=>{const u=state.members.get(b.dataset.user);if(confirm(`Remover ${u?.name||'membro'} do servidor?`)){state.socket.emit('member:kick',{serverId:s.id,userId:b.dataset.user});closeModal()}})}
function openMemberProfile(userId){const u=state.members.get(userId);if(!u)return;const role=u.role||roleFor(userId);openModal(`<h2>${escapeHtml(u.name)}</h2><div class="profile-preview"><div id="profilePreviewAvatar" class="avatar" style="width:76px;height:76px;font-size:28px"></div><p><span class="status-dot status-${escapeHtml(u.status||'offline')}"></span>${STATUS_LABEL[u.status||'offline']||'Offline'}</p><span class="role-badge role-${role}">${ROLE_LABEL[role]}</span></div>`);avatarStyle($('profilePreviewAvatar'),u)}
els.profileBtn.addEventListener('click',openSettings);els.updateBadge?.addEventListener('click',async()=>{if(state.updates.state?.status==='downloaded'){await ipcRenderer.invoke('update:install');return}await openSettings();setTimeout(()=>$('tabUpdates')?.click(),0)});

function micConstraints(){const base={echoCancellation:state.media.echoCancellation,noiseSuppression:state.media.noiseSuppression,autoGainControl:state.media.autoGainControl,channelCount:1};if(state.media.micId)base.deviceId={exact:state.media.micId};return base}
function resolutionFor(value){return value==='1080'?{width:1920,height:1080}:value==='480'?{width:854,height:480}:{width:1280,height:720}}
function cameraConstraints(){const q=resolutionFor(state.media.cameraQuality);const c={width:{ideal:q.width},height:{ideal:q.height},frameRate:{ideal:state.media.cameraFps,max:state.media.cameraFps}};if(state.media.cameraId)c.deviceId={exact:state.media.cameraId};return c}
function peerVolume(userId){const v=Number(state.media.peerVolumes?.[userId]);return Number.isFinite(v)?Math.min(1,Math.max(0,v)):1}
async function applyOutputDevice(mediaEl,userId=''){if(!mediaEl)return;const base=Math.min(1,Math.max(0,state.media.outputVolume||0));mediaEl.volume=state.voice.deafened?0:Math.min(1,base*peerVolume(userId));if(state.media.speakerId&&typeof mediaEl.setSinkId==='function'){try{await mediaEl.setSinkId(state.media.speakerId)}catch(e){console.warn('speaker output',e)}}}
async function enumerateMediaDevices(withPermission=false){let temp=null;if(withPermission){try{temp=await navigator.mediaDevices.getUserMedia({audio:true,video:false})}catch{}}const devices=await navigator.mediaDevices.enumerateDevices();temp?.getTracks().forEach(t=>t.stop());return devices}
function fillDeviceSelect(select,devices,kind,current,label){if(!select)return;const rows=devices.filter(d=>d.kind===kind);select.innerHTML='';const def=document.createElement('option');def.value='';def.textContent=`Padrão do Windows (${label})`;select.appendChild(def);rows.forEach((d,i)=>{const o=document.createElement('option');o.value=d.deviceId;o.textContent=d.label||`${label} ${i+1}`;select.appendChild(o)});select.value=rows.some(d=>d.deviceId===current)?current:''}

let micTest={stream:null,ctx:null,raf:null};function stopMicTest(){if(micTest.raf)cancelAnimationFrame(micTest.raf);micTest.stream?.getTracks().forEach(t=>t.stop());try{micTest.ctx?.close()}catch{}micTest={stream:null,ctx:null,raf:null};if($('micLevelBar'))$('micLevelBar').style.width='0%';if($('micTestState'))$('micTestState').textContent='Teste parado';if($('testMicBtn'))$('testMicBtn').textContent='🎤 Testar microfone'}
async function startMicTest(){stopMicTest();try{const c={echoCancellation:true,noiseSuppression:true,autoGainControl:true};const selected=$('micSelect')?.value||state.media.micId;if(selected)c.deviceId={exact:selected};const stream=await navigator.mediaDevices.getUserMedia({audio:c,video:false});const ctx=new AudioContext(),source=ctx.createMediaStreamSource(stream),analyser=ctx.createAnalyser();analyser.fftSize=512;source.connect(analyser);const data=new Uint8Array(analyser.frequencyBinCount);micTest={stream,ctx,raf:null};$('micTestState').textContent='Fale alguma coisa…';$('testMicBtn').textContent='⏹ Parar teste';const tick=()=>{analyser.getByteTimeDomainData(data);let sum=0;for(const v of data){const n=(v-128)/128;sum+=n*n}const level=Math.min(100,Math.round(Math.sqrt(sum/data.length)*360));if($('micLevelBar'))$('micLevelBar').style.width=`${level}%`;micTest.raf=requestAnimationFrame(tick)};tick()}catch{toast('Não consegui acessar esse microfone. Confira a permissão do Windows.',4000)}}
async function testSpeaker(){try{const ctx=new AudioContext(),osc=ctx.createOscillator(),gain=ctx.createGain(),dest=ctx.createMediaStreamDestination();osc.frequency.value=523.25;gain.gain.value=.12;osc.connect(gain).connect(dest);osc.start();const audio=new Audio();audio.srcObject=dest.stream;audio.volume=Math.min(1,Math.max(0,Number($('outputVolume')?.value??state.media.outputVolume)));const sink=$('speakerSelect')?.value||state.media.speakerId;if(sink&&typeof audio.setSinkId==='function')await audio.setSinkId(sink);await audio.play();setTimeout(()=>{try{osc.stop();audio.pause();ctx.close()}catch{}},700)}catch{toast('Não consegui tocar o som de teste nessa saída.',3500)}}
let cameraTest={stream:null};function stopCameraTest(){cameraTest.stream?.getTracks().forEach(t=>t.stop());cameraTest={stream:null};if($('cameraPreview'))$('cameraPreview').srcObject=null;if($('testCameraBtn'))$('testCameraBtn').textContent='📹 Testar câmera'}
async function startCameraTest(){stopCameraTest();try{const q=resolutionFor($('cameraQuality')?.value||state.media.cameraQuality),fps=Number($('cameraFps')?.value||state.media.cameraFps),c={width:{ideal:q.width},height:{ideal:q.height},frameRate:{ideal:fps,max:fps}};const id=$('cameraSelect')?.value||state.media.cameraId;if(id)c.deviceId={exact:id};cameraTest.stream=await navigator.mediaDevices.getUserMedia({video:c,audio:false});const v=$('cameraPreview');v.srcObject=cameraTest.stream;v.play().catch(()=>{});$('testCameraBtn').textContent='⏹ Parar câmera'}catch{toast('Não consegui abrir essa câmera.',3500)}}
async function refreshAllOutputs(){for(const p of state.voice.peers.values())await applyOutputDevice($(`video-${p.socketId}`)?.querySelector('audio.remote-audio'),p.user?.id||'')}
async function switchMicrophoneInCall(){if(!state.voice.channelId)return;let stream;try{stream=await navigator.mediaDevices.getUserMedia({audio:micConstraints(),video:false})}catch{return toast('Não consegui trocar o microfone durante a chamada.',4000)}const track=stream.getAudioTracks()[0];const old=state.voice.localAudio;state.voice.localAudio=stream;applyMicTrackState();for(const p of state.voice.peers.values()){let sender=p.pc.getSenders().find(s=>s._bananaMic);if(sender)await sender.replaceTrack(track);else{sender=p.pc.addTrack(track,stream);sender._bananaMic=true;await renegotiate(p)}}old?.getTracks().forEach(t=>t.stop());startLocalVAD();toast('Microfone atualizado na chamada.')}

function diagnosticsHtml(){const peers=[...state.voice.peers.values()];const rows=peers.length?peers.map(p=>`<div class="diag-row"><b>${escapeHtml(p.user?.name||'Amigo')}</b><span>WebRTC: ${escapeHtml(p.pc.connectionState||'novo')} · ICE: ${escapeHtml(p.pc.iceConnectionState||'novo')} · áudio ${p.remoteStream.getAudioTracks().filter(t=>t.readyState==='live').length} · vídeo ${p.remoteStream.getVideoTracks().filter(t=>t.readyState==='live').length}</span></div>`).join(''):'<p><small>Você não está conectado a outras pessoas em uma sala de voz.</small></p>';return`<div class="diagnostics"><div class="diag-row"><b>Servidor</b><span>${escapeHtml(state.serverUrl||'--')}</span></div><div class="diag-row"><b>Ping do servidor</b><span>${escapeHtml(els.ping.textContent||'--')}</span></div><div class="diag-row"><b>Sala de voz</b><span>${state.voice.channelId?'Conectado':'Fora da voz'}</span></div>${rows}<button class="secondary" id="refreshDiag">Atualizar diagnóstico</button><button class="secondary" id="reconnectVoice">Reconectar voz</button></div>`}
async function openSettings(){
  stopMicTest();stopCameraTest();openModal(`<h2>Configurações</h2><div class="settings-tabs"><button id="tabProfile" class="active">Perfil</button><button id="tabAudio">Áudio</button><button id="tabVideo">Vídeo e tela</button><button id="tabGeneral">Geral</button><button id="tabDiag">Diagnóstico</button><button id="tabUpdates">Atualizações</button></div><div id="settingsArea"></div>`);const area=$('settingsArea');const activate=id=>{for(const x of ['tabProfile','tabAudio','tabVideo','tabGeneral','tabDiag','tabUpdates'])$(x)?.classList.toggle('active',x===id)};
