function wireChannelDrag(row,c){row.addEventListener('dragstart',e=>{row.classList.add('dragging');e.dataTransfer.setData('text/plain',c.id);e.dataTransfer.effectAllowed='move'});row.addEventListener('dragend',()=>row.classList.remove('dragging'));row.addEventListener('dragover',e=>{e.preventDefault();row.classList.add('drag-over')});row.addEventListener('dragleave',()=>row.classList.remove('drag-over'));row.addEventListener('drop',e=>{e.preventDefault();row.classList.remove('drag-over');const from=e.dataTransfer.getData('text/plain');if(from&&from!==c.id)state.socket.emit('channel:reorder',{serverId:state.selectedServer.id,channelId:from,beforeId:c.id})})}
function renderVoiceUsers(wrap,channelId){const entries=state.voicePresence.get(channelId)||[];if(!entries.length)return;const list=document.createElement('div');list.className='voice-user-list';for(const e of entries){const u=e.user||{name:'Amigo'};const row=document.createElement('div');row.className='voice-user-row'+(e.speaking&&!e.mediaState?.muted?' speaking':'')+(u.id===state.user?.id?' self':'');const av=document.createElement('div');av.className='avatar';avatarStyle(av,u);const nm=document.createElement('span');nm.className='voice-user-name';nm.textContent=u.name;const icons=document.createElement('span');icons.className='voice-user-icons';const peer=e.socketId?state.voice.peers.get(e.socketId):null;const latency=peer?.rtt!=null?`${peer.rtt}ms`:u.id===state.user?.id?(els.ping.textContent||''):'';icons.textContent=`${e.mediaState?.muted?'🔇':''}${e.mediaState?.camera?'📹':''}${e.mediaState?.screen?'🖥️':''}${latency?` · ${latency}`:''}`;row.append(av,nm,icons);row.title=`${u.name}${e.speaking?' está falando':''}`;row.addEventListener('click',()=>openMemberProfile(u.id));list.appendChild(row)}wrap.appendChild(list)}
function selectChannel(id){const c=state.selectedServer?.channels.find(x=>x.id===id);if(!c)return;state.selectedChannel=c;els.emptyView.classList.add('hidden');renderChannels();els.channelName.textContent=c.name;if(c.type==='text'){els.channelIcon.textContent='#';els.channelDesc.textContent='Conversa do servidor';els.textView.classList.remove('hidden');els.voiceView.classList.add('hidden');state.socket.emit('messages:load',{serverId:state.selectedServer.id,channelId:c.id});setTimeout(()=>els.messageInput.focus(),0)}else{els.channelIcon.textContent='🔊';els.channelDesc.textContent='Canal de voz';els.textView.classList.add('hidden');els.voiceView.classList.remove('hidden');els.voiceTitle.textContent=c.name;updateVoiceUI()}}
function renderMembers(){els.memberList.innerHTML='';const arr=[...state.members.values()].sort((a,b)=>(b.status==='online')-(a.status==='online')||(ROLE_RANK[b.role||'member']-ROLE_RANK[a.role||'member'])||a.name.localeCompare(b.name));for(const u of arr){const role=u.role||roleFor(u.id);const row=document.createElement('div');row.className='member'+(u.status==='offline'?' offline':'');const av=document.createElement('div');av.className='avatar';avatarStyle(av,u);const tx=document.createElement('div');tx.className='member-name';tx.innerHTML=`<b class="role-color-${role}">${escapeHtml(u.name)}${role==='owner'?' 👑':''}</b><small><span class="status-dot status-${escapeHtml(u.status||'offline')}"></span>${STATUS_LABEL[u.status||'offline']||'Offline'} · <span class="role-badge role-${role}">${ROLE_LABEL[role]}</span></small>`;row.append(av,tx);row.title='Ver perfil';row.addEventListener('click',()=>openMemberProfile(u.id));els.memberList.appendChild(row)}}
function renderMessages(forceBottom=false){if(!state.selectedChannel||state.selectedChannel.type!=='text')return;const wasBottom=els.messages.scrollHeight-els.messages.scrollTop-els.messages.clientHeight<90;els.messages.innerHTML='';for(const m of state.messagesByChannel.get(state.selectedChannel.id)||[]){const u=state.members.get(m.authorId)||{name:'Usuário'};const role=u.role||roleFor(m.authorId);const row=document.createElement('div');row.className='message';const av=document.createElement('div');av.className='avatar';avatarStyle(av,u);const body=document.createElement('div');body.innerHTML=`<div class="msg-head"><b class="role-color-${role}">${escapeHtml(u.name)}</b><small>${fmtTime(m.at)}</small></div><div class="msg-text">${escapeHtml(m.text)}</div>`;row.append(av,body);els.messages.appendChild(row)}if(forceBottom||wasBottom)els.messages.scrollTop=els.messages.scrollHeight}

function updateDmUnreadBadge(){const count=state.dmUnread.size;if(!els.dmUnreadBadge)return;els.dmUnreadBadge.textContent=count>9?'9+':String(count);els.dmUnreadBadge.classList.toggle('hidden',count===0)}
function mergeDmConversation(user,lastMessage){if(!user?.id)return;const i=state.dmConversations.findIndex(c=>c.user?.id===user.id);const next={user,lastMessage:lastMessage||(i>=0?state.dmConversations[i].lastMessage:null)};if(i>=0)state.dmConversations[i]=next;else state.dmConversations.push(next);state.dmConversations.sort((a,b)=>Number(b.lastMessage?.at||0)-Number(a.lastMessage?.at||0))}
function dmPeer(userId){return state.dmConversations.find(c=>c.user?.id===userId)?.user||state.members.get(userId)||null}
function renderDmSidebar(){if(state.viewMode!=='dm')return;els.channels.innerHTML='';const top=document.createElement('div');top.className='dm-sidebar';top.innerHTML='<div class="channel-section-title"><span>Mensagens privadas</span></div><button id="newDmBtn" class="dm-new-btn">＋ Nova mensagem</button><div id="dmConversationList" class="dm-conversation-list"></div>';els.channels.appendChild(top);$('newDmBtn').onclick=openNewDmModal;const list=$('dmConversationList');for(const c of state.dmConversations){const u=c.user;if(!u?.id)continue;const row=document.createElement('button');row.className='dm-row'+(state.activeDmUserId===u.id?' active':'');const av=document.createElement('div');av.className='avatar';avatarStyle(av,u);const txt=document.createElement('div');txt.className='dm-row-text';const preview=c.lastMessage?.text?escapeHtml(c.lastMessage.text):'Iniciar conversa';txt.innerHTML=`<b>${escapeHtml(u.name||'Amigo')}</b><small>${preview}</small>`;const meta=document.createElement('div');meta.className='dm-row-meta';meta.innerHTML=`<span class="status-dot status-${escapeHtml(u.status||'offline')}"></span>${state.dmUnread.has(u.id)?'<span class="dm-unread-dot"></span>':''}`;row.append(av,txt,meta);row.onclick=()=>startDm(u.id,u);list.appendChild(row)}if(!state.dmConversations.length){const empty=document.createElement('div');empty.className='dm-empty-list';empty.textContent='Nenhuma conversa ainda.';list.appendChild(empty)}}
function showDmHome(){state.viewMode='dm';state.activeDmUserId=null;state.selectedChannel=null;els.app.classList.add('dm-mode');els.serverName.textContent='Privado';els.inviteBtn.style.visibility='hidden';els.serverSettingsBtn.style.visibility='hidden';renderServers();renderDmSidebar();els.channelIcon.textContent='💬';els.channelName.textContent='Mensagens privadas';els.channelDesc.textContent='Converse diretamente com seus amigos';els.textView.classList.add('hidden');els.voiceView.classList.add('hidden');els.emptyView.innerHTML='<div class="big-banana">🍌</div><h2>Mensagens privadas</h2><p>Escolha uma conversa na lateral ou inicie uma nova.</p>';els.emptyView.classList.remove('hidden');state.socket?.emit('dm:conversations:get')}
function startDm(userId,user=null){if(!userId||userId===state.user?.id)return;const peer=user||dmPeer(userId);if(peer)mergeDmConversation(peer,null);state.viewMode='dm';state.activeDmUserId=userId;state.selectedChannel=null;state.dmUnread.delete(userId);updateDmUnreadBadge();els.app.classList.add('dm-mode');els.serverName.textContent='Privado';els.inviteBtn.style.visibility='hidden';els.serverSettingsBtn.style.visibility='hidden';renderServers();renderDmSidebar();els.emptyView.classList.add('hidden');els.voiceView.classList.add('hidden');els.textView.classList.remove('hidden');els.channelIcon.textContent='@';els.channelName.textContent=peer?.name||'Mensagem privada';els.channelDesc.textContent='Mensagem privada';els.messageInput.placeholder=`Mensagem para ${peer?.name||'seu amigo'}`;renderDmMessages();state.socket?.emit('dm:load',{userId});setTimeout(()=>els.messageInput.focus(),0)}
function renderDmMessages(forceBottom=false){if(state.viewMode!=='dm'||!state.activeDmUserId)return;const wasBottom=els.messages.scrollHeight-els.messages.scrollTop-els.messages.clientHeight<90;const peer=dmPeer(state.activeDmUserId)||{id:state.activeDmUserId,name:'Amigo'};els.messages.innerHTML='';for(const m of state.dmMessages.get(state.activeDmUserId)||[]){const mine=m.fromId===state.user?.id;const u=mine?state.user:peer;const row=document.createElement('div');row.className='message dm-message';const av=document.createElement('div');av.className='avatar';avatarStyle(av,u);const body=document.createElement('div');body.innerHTML=`<div class="msg-head"><b>${escapeHtml(mine?'Você':u?.name||'Amigo')}</b><small>${fmtTime(m.at)}</small></div><div class="msg-text">${escapeHtml(m.text)}</div>`;row.append(av,body);els.messages.appendChild(row)}if(!els.messages.children.length)els.messages.innerHTML='<div class="dm-conversation-empty"><b>Comece a conversa 👋</b><span>As mensagens ficam armazenadas no Banana Cord do host.</span></div>';if(forceBottom||wasBottom)els.messages.scrollTop=els.messages.scrollHeight}
function openNewDmModal(){const candidates=[...state.members.values()].filter(u=>u.id!==state.user?.id);openModal(`<div class="simple-modal-head"><h2>Nova mensagem</h2><p>Escolha alguém deste servidor.</p></div><div class="dm-picker">${candidates.map(u=>`<button class="dm-picker-row" data-user="${escapeHtml(u.id)}"><span class="dm-picker-avatar avatar" data-avatar="${escapeHtml(u.id)}"></span><span><b>${escapeHtml(u.name)}</b><small>${STATUS_LABEL[u.status||'offline']||'Offline'}</small></span></button>`).join('')||'<p>Nenhum outro membro disponível.</p>'}</div>`);for(const av of document.querySelectorAll('.dm-picker-avatar'))avatarStyle(av,state.members.get(av.dataset.avatar));for(const b of document.querySelectorAll('.dm-picker-row'))b.onclick=()=>{const u=state.members.get(b.dataset.user);closeModal();startDm(b.dataset.user,u)}}

els.messageForm.addEventListener('submit',e=>{e.preventDefault();const text=els.messageInput.value.trim();if(!text)return;if(state.viewMode==='dm'&&state.activeDmUserId){state.socket.emit('dm:send',{userId:state.activeDmUserId,text});els.messageInput.value='';return}if(!state.selectedServer||state.selectedChannel?.type!=='text')return;state.socket.emit('message:send',{serverId:state.selectedServer.id,channelId:state.selectedChannel.id,text});els.messageInput.value=''});
els.homeServer?.addEventListener('click',showDmHome);
