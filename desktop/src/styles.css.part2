.settings-tabs{display:flex;gap:8px;margin:0 0 18px}.settings-tabs button{flex:1;border:1px solid #3b3d42;background:#2a2c30;color:#d7d7dc;padding:10px 12px;border-radius:8px;cursor:pointer}.settings-tabs button.active{background:var(--accent);color:#241d00;border-color:var(--accent);font-weight:800}.audio-settings label{display:block;margin:14px 0 6px;font-size:12px;font-weight:800;text-transform:uppercase;color:#c9c9cf}.audio-settings select,.audio-settings input[type=range]{width:100%}.audio-settings select{background:#151517;border:1px solid #444;color:white;border-radius:8px;padding:11px}.audio-settings button.secondary{width:100%;margin-top:9px;background:#303238;color:#f2f2f4;border:1px solid #44474d;padding:10px;border-radius:8px;cursor:pointer}.audio-settings .action{margin-top:18px}.mic-meter{height:12px;background:#131416;border:1px solid #3b3d42;border-radius:999px;overflow:hidden;margin:10px 0 6px}.mic-meter span{display:block;width:0;height:100%;background:linear-gradient(90deg,#45c76f,#f3c623,#e24c4c);transition:width .05s linear}.audio-settings small{display:block;color:#9fa0a7;margin-top:6px}.settings-note{line-height:1.45;margin-top:12px!important}

/* Banana Cord v0.4 - chamadas e compartilhamento */
:root{--accent:var(--yellow)}
.control-row{grid-template-columns:repeat(5,1fr)}
.video-card.speaking{border-color:#35d275;box-shadow:0 0 0 2px #35d27555 inset}
.video-card.is-sharing{grid-column:1 / -1;min-height:360px}
.video-card:fullscreen{width:100%;height:100%;border-radius:0;background:#050607;display:grid;place-items:center}
.video-card:fullscreen video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
.video-card:fullscreen .video-placeholder{width:100%;height:100%}
.video-card audio.remote-audio{display:none}
.expand-btn{position:absolute;top:8px;left:8px;z-index:4;width:34px!important;height:30px;padding:0!important;margin:0!important;border-radius:7px!important;background:#000b!important;color:#fff!important;font-size:18px!important}
.audio-unlock{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:5;width:auto!important;padding:9px 13px!important;margin:0!important;background:#f3c623!important;color:#1a1605!important;border-radius:8px!important;font-weight:800}
.peer-volume{position:absolute;right:8px;bottom:8px;z-index:4;display:flex;align-items:center;gap:5px;background:#000a;border-radius:7px;padding:4px 7px}
.peer-volume input[type=range]{width:78px;padding:0;background:transparent;border:0}
.peer-volume small{font-size:10px;color:#eee;min-width:30px;text-align:right}
.video-card .video-label{max-width:55%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.settings-tabs{overflow-x:auto}.settings-tabs button{min-width:max-content}
.settings-sep{border:0;border-top:1px solid #35373c;margin:20px 0}
.settings-2col{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.switch-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}
.switch-line{display:flex!important;align-items:center;gap:8px;margin:0!important;padding:9px;border:1px solid #383b40;border-radius:8px;background:#181a1d;text-transform:none!important;letter-spacing:0!important;font-weight:600!important;color:#ddd!important}
.switch-line input{width:auto;margin:0}
.camera-preview{width:100%;max-height:260px;background:#101113;border:1px solid #34363d;border-radius:10px;margin-top:10px;object-fit:contain}
.diagnostics{display:grid;gap:9px}.diag-row{display:grid;gap:4px;background:#17181b;border:1px solid #36383e;border-radius:8px;padding:10px}.diag-row b{font-size:12px}.diag-row span{color:#aeb2ba;font-size:12px;word-break:break-word}
@media(max-width:900px){.video-card.is-sharing{min-height:300px}.settings-2col,.switch-grid{grid-template-columns:1fr}}

/* Banana Cord v0.8 */
.server-actions{display:flex;align-items:center;gap:2px}.server-title strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.voice-top-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap;justify-content:flex-end}.voice-top .secondary-mini{width:auto;margin:0;background:#303238;color:#f3f4f5;border:1px solid #45484f;padding:8px 10px;border-radius:8px;font-weight:700}.voice-top .secondary-mini.active{background:#3c3520;border-color:#8a7420;color:#ffe36b}
.channel-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;border-radius:7px}.channel-row.dragging{opacity:.45}.channel-row.drag-over{outline:1px solid var(--yellow)}.channel-row .channel{min-width:0}.channel-actions{display:flex;align-items:center}.channel-more{background:transparent;color:#777c85;width:27px;height:27px;border-radius:6px}.channel-more:hover{background:#34363b;color:#fff}
.voice-user-list{display:grid;gap:2px;padding:2px 5px 6px 34px}.voice-user-row{display:flex;align-items:center;gap:7px;min-width:0;padding:3px 4px;border-radius:6px;color:#999ea7;font-size:11px}.voice-user-row:hover{background:#23252a;color:#ddd}.voice-user-row .avatar{width:23px;height:23px;font-size:10px;outline:2px solid transparent;transition:outline-color .08s,box-shadow .08s}.voice-user-row.speaking{color:#dfffea}.voice-user-row.speaking .avatar{outline-color:#35d275;box-shadow:0 0 0 2px #35d27533}.voice-user-row .voice-user-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}.voice-user-icons{display:flex;gap:3px;font-size:10px;opacity:.8}
.member{cursor:pointer}.member:hover{background:#222429}.member .avatar{position:relative}.member .role-badge{font-size:9px;padding:2px 5px;border-radius:999px;margin-top:2px;display:inline-block}.role-owner{color:#f8d75a;background:#4d431c}.role-admin{color:#ff9b9b;background:#50272a}.role-moderator{color:#8bd6ff;background:#1d3f52}.role-member{color:#a9adb6;background:#2b2d31}.status-dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:4px}.status-online{background:#23a55a}.status-busy{background:#da373c}.status-away{background:#f0b232}.status-offline{background:#6d717a}
.video-grid.focus-sharing .video-card:not(.is-sharing):not(.pinned){display:none}.video-card.pinned{grid-column:1/-1;min-height:440px}.pin-btn{position:absolute;top:8px;left:48px;z-index:4;width:34px!important;height:30px;padding:0!important;margin:0!important;border-radius:7px!important;background:#000b!important;color:#fff!important;font-size:15px!important}.video-card.pinned .pin-btn{background:#f3c623!important;color:#1a1605!important}.video-card .avatar-video{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:74px;height:74px;border-radius:50%;display:grid;place-items:center;background:#4e525a;background-size:cover;background-position:center;font-size:28px;font-weight:800}.video-card.speaking .avatar-video{outline:3px solid #35d275;box-shadow:0 0 0 5px #35d27522}.video-card .connection-state{position:absolute;top:42px;right:8px;background:#0008;border-radius:5px;padding:3px 6px;font-size:9px;color:#aaa}
.role-table{display:grid;gap:8px}.role-row{display:grid;grid-template-columns:36px minmax(0,1fr) 130px auto;gap:8px;align-items:center;background:#181a1d;border:1px solid #36383e;border-radius:9px;padding:8px}.role-row .avatar{width:34px;height:34px}.role-row select{background:#111214;color:#eee;border:1px solid #404349;border-radius:7px;padding:8px}.role-row .remove-member{background:#4d2528!important;color:#ffd5d7!important;width:auto!important;margin:0!important;padding:8px!important}.server-settings-grid{display:grid;gap:10px}.permission-note{background:#181a1d;border:1px solid #34363d;border-radius:9px;padding:10px;color:#b6bac2;font-size:12px;line-height:1.45}.server-settings-actions{display:flex;gap:8px}.server-settings-actions button{flex:1}
.shortcut-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.quality-preset{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}.quality-preset label{margin:0!important;text-transform:none!important;font-size:12px!important;letter-spacing:0!important}.quality-preset input{width:auto}.setting-chip{display:flex;align-items:center;gap:7px;border:1px solid #383b40;background:#181a1d;padding:9px;border-radius:8px}.setting-chip input{width:auto}.settings-help{padding:9px 10px;border-radius:8px;background:#17181b;border:1px solid #34363d;color:#a8acb5;font-size:12px;line-height:1.45;margin-top:10px}.version-label{font-size:10px;color:#6f747d;margin-top:6px}.profile-status-select{background:#151517;border:1px solid #444;color:white;border-radius:8px;padding:11px;width:100%}
@media(max-width:900px){.role-row{grid-template-columns:34px minmax(0,1fr);}.role-row select,.role-row .remove-member{grid-column:2}.shortcut-grid{grid-template-columns:1fr}.voice-top-actions{justify-content:flex-start}.video-card.pinned{min-height:320px}}
.video-grid.has-pin .video-card:not(.pinned){display:none}.voice-user-row.self{color:#cfd2d7}.member-name .role-color-owner{color:#f4d35e}.member-name .role-color-admin{color:#ff9b9b}.member-name .role-color-moderator{color:#7ecfff}.member-name .role-color-member{color:#e4e6ea}
.danger-action{background:#4d2528!important;color:#ffd5d7!important}.profile-preview{text-align:center;padding:12px}.profile-preview .avatar{margin:0 auto 10px}.role-row small{display:block;color:#8f949e;margin-top:2px}

/* v0.9 - atualizações */
