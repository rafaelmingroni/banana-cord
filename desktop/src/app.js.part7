  const showUpdates=async()=>{stopMicTest();stopCameraTest();activate('tabUpdates');let cfg=state.updates.config||{},ust=state.updates.state||{};try{cfg=await ipcRenderer.invoke('update:get-config');ust=await ipcRenderer.invoke('update:get-state');state.updates.config=cfg;state.updates.state=ust}catch{}const labels={idle:'Pronto para verificar',checking:'Verificando…',available:'Nova versão disponível',downloading:'Baixando atualização…',downloaded:'Atualização pronta','up-to-date':'Você está atualizado','not-configured':'Fonte não configurada',dev:'Disponível no app instalado',error:'Erro na atualização'};const statusLabel=labels[ust.status]||ust.message||'--';area.innerHTML=`<div class="settings-card update-settings"><div class="settings-card-head compact"><div><span class="settings-kicker">BANANA CORD</span><h3>Atualizações</h3><p>As novas versões vêm do seu repositório oficial no GitHub.</p></div></div><div class="update-version"><div><small>VERSÃO INSTALADA</small><b>${escapeHtml(cfg.currentVersion||ust.currentVersion||'0.10.0')}</b></div><div><small>ÚLTIMA VERSÃO</small><b>${escapeHtml(ust.latestVersion||'--')}</b></div></div><div class="settings-field"><label>Repositório público</label><input id="updateRepoUrl" value="${escapeHtml(cfg.repoUrl||'')}" placeholder="https://github.com/rafaelmingroni/banana-cord"></div><div class="switch-grid"><label class="switch-line"><input id="autoCheckUpdates" type="checkbox" ${cfg.autoCheck!==false?'checked':''}> Verificar ao abrir</label><label class="switch-line"><input id="autoDownloadUpdates" type="checkbox" ${cfg.autoDownload!==false?'checked':''}> Baixar automaticamente</label></div><div class="update-status"><b>${escapeHtml(statusLabel)}</b><small>${escapeHtml(ust.message||'')}</small><div class="update-progress"><span style="width:${Math.max(0,Math.min(100,Number(ust.progress||0)))}%"></span></div></div><div class="settings-actions"><button class="action" id="saveUpdateSettings">Salvar</button><button class="secondary" id="checkUpdateNow">Verificar agora</button>${ust.status==='available'?'<button class="secondary" id="downloadUpdateNow">Baixar</button>':''}${ust.status==='downloaded'?'<button class="action" id="installUpdateNow">Reiniciar e instalar</button>':''}</div></div>`;$('saveUpdateSettings').onclick=async()=>{try{state.updates.config=await ipcRenderer.invoke('update:save-config',{repoUrl:$('updateRepoUrl').value.trim(),autoCheck:$('autoCheckUpdates').checked,autoDownload:$('autoDownloadUpdates').checked});toast('Configurações de atualização salvas.');showUpdates()}catch(e){toast(e?.message||'Não consegui salvar.',4500)}};$('checkUpdateNow').onclick=async()=>{try{await ipcRenderer.invoke('update:check')}catch(e){toast(e?.message||'Falha ao verificar.',4500)}showUpdates()};if($('downloadUpdateNow'))$('downloadUpdateNow').onclick=async()=>{try{await ipcRenderer.invoke('update:download')}catch(e){toast(e?.message||'Falha ao baixar.',4500)}};if($('installUpdateNow'))$('installUpdateNow').onclick=()=>ipcRenderer.invoke('update:install')};
  $('tabProfile').onclick=showProfile;$('tabAudio').onclick=showAudio;$('tabVideo').onclick=showVideo;$('tabGeneral').onclick=showGeneral;$('tabDiag').onclick=showDiag;$('tabUpdates').onclick=showUpdates;showProfile();
}
function prettyKey(code){return String(code||'KeyV').replace(/^Key/,'').replace(/^Digit/,'').replace('Control','Ctrl ').replace('Shift','Shift ').replace('Alt','Alt ')}

els.joinVoiceBtn.addEventListener('click',async()=>{if(state.voice.channelId===state.selectedChannel?.id)return leaveVoice();await joinVoice(state.selectedChannel)});els.hangupBtn.addEventListener('click',leaveVoice);els.muteBtn.addEventListener('click',toggleMute);els.deafenBtn.addEventListener('click',toggleDeafen);els.cameraBtn.addEventListener('click',toggleCamera);els.screenBtn.addEventListener('click',toggleScreen);els.reconnectVoiceBtn.addEventListener('click',reconnectCurrentVoice);els.hideCamsBtn.addEventListener('click',()=>{state.ui.showAllOverride=!state.ui.showAllOverride;applyFocusSharing()});
function toggleMute(){if(!state.voice.channelId)return;state.voice.muted=!state.voice.muted;applyMicTrackState();els.muteBtn.classList.toggle('off',state.voice.muted);els.muteBtn.textContent=state.voice.muted?'🔇':'🎤';updateLocalVideo();emitMediaState();if(state.voice.muted)setLocalSpeaking(false)}
async function toggleDeafen(){if(!state.voice.channelId)return;state.voice.deafened=!state.voice.deafened;els.deafenBtn.classList.toggle('off',state.voice.deafened);els.deafenBtn.textContent=state.voice.deafened?'🔕':'🎧';await refreshAllOutputs()}
function applyMicTrackState(){const enabled=!state.voice.muted&&(!state.ui.pttEnabled||state.voice.pttHeld);for(const t of state.voice.localAudio?.getAudioTracks()||[])t.enabled=enabled;if(!enabled)setLocalSpeaking(false)}
function emitMediaState(){if(state.voice.channelId&&state.socket?.connected)state.socket.emit('voice:media-state',{muted:state.voice.muted|| (state.ui.pttEnabled&&!state.voice.pttHeld),camera:!!state.voice.camera,screen:!!state.voice.screen})}
function setCardSpeaking(id,on){$(id)?.classList.toggle('speaking',!!on)}
function setLocalSpeaking(on){if(state.voice.speaking===!!on)return;state.voice.speaking=!!on;setCardSpeaking('video-local',state.voice.speaking);if(state.voice.channelId)state.socket.emit('voice:speaking',{speaking:state.voice.speaking})}
function stopLocalVAD(){const v=state.voice.vad;if(!v)return;if(v.raf)cancelAnimationFrame(v.raf);try{v.ctx?.close()}catch{}state.voice.vad=null;state.voice.speaking=false;setCardSpeaking('video-local',false)}
function startLocalVAD(){stopLocalVAD();if(!state.voice.localAudio?.getAudioTracks().length)return;try{const ctx=new AudioContext(),src=ctx.createMediaStreamSource(state.voice.localAudio),analyser=ctx.createAnalyser();analyser.fftSize=512;analyser.smoothingTimeConstant=.45;src.connect(analyser);const data=new Uint8Array(analyser.frequencyBinCount),vad={ctx,analyser,data,raf:null,quietSince:0};state.voice.vad=vad;const tick=()=>{if(state.voice.vad!==vad)return;analyser.getByteTimeDomainData(data);let sum=0;for(const v of data){const n=(v-128)/128;sum+=n*n}const level=Math.min(100,Math.round(Math.sqrt(sum/data.length)*360)),threshold=state.media.voiceThreshold,now=performance.now(),allowed=!state.voice.muted&&(!state.ui.pttEnabled||state.voice.pttHeld);if(allowed&&level>=threshold){vad.quietSince=0;setLocalSpeaking(true)}else if(state.voice.speaking){if(!vad.quietSince)vad.quietSince=now;if(now-vad.quietSince>220)setLocalSpeaking(false)}vad.raf=requestAnimationFrame(tick)};tick()}catch(e){console.warn('VAD',e)}}

async function joinVoice(channel){if(!channel||channel.type!=='voice')return;if(state.voice.channelId)await leaveVoice();try{state.voice.localAudio=await navigator.mediaDevices.getUserMedia({audio:micConstraints(),video:false})}catch{return toast('Não consegui acessar seu microfone. Abra ⚙️ → Áudio e teste o microfone.')}state.voice.serverId=state.selectedServer.id;state.voice.channelId=channel.id;state.voice.muted=!!state.media.autoMute;state.voice.deafened=false;state.voice.pttHeld=false;applyMicTrackState();state.socket.emit('voice:join',{serverId:state.voice.serverId,channelId:channel.id});addLocalCard();startLocalVAD();updateVoiceUI();startPeerStats();setTimeout(emitMediaState,250)}
async function leaveVoice(){if(state.voice.channelId&&state.socket?.connected)state.socket.emit('voice:leave');cleanupVoice();updateVoiceUI()}
function clearPeersOnly(){for(const p of state.voice.peers.values()){try{p.pc.close()}catch{}$(`video-${p.socketId}`)?.remove()}state.voice.peers.clear()}
async function rejoinVoiceTransport(){if(!state.voice.channelId||!state.socket?.connected)return;clearPeersOnly();state.socket.emit('voice:join',{serverId:state.voice.serverId,channelId:state.voice.channelId});addLocalCard();startPeerStats();setTimeout(emitMediaState,250)}
async function reconnectCurrentVoice(){if(!state.voice.channelId)return toast('Entre em uma sala de voz primeiro.');await rejoinVoiceTransport();toast('Reconectando voz…')}
function cleanupVoice(){clearInterval(state.voice.statsTimer);clearTimeout(state.voice.rejoinTimer);stopLocalVAD();clearPeersOnly();for(const stream of[state.voice.localAudio,state.voice.camera,state.voice.screen])stream?.getTracks().forEach(t=>t.stop());state.voice={channelId:null,serverId:null,localAudio:null,camera:null,screen:null,muted:false,deafened:false,speaking:false,pttHeld:false,peers:new Map(),statsTimer:null,vad:null,rejoinTimer:null};els.videoGrid.innerHTML='';els.videoGrid.classList.remove('focus-sharing','has-pin');els.voiceControls.classList.add('hidden');els.muteBtn.classList.remove('off');els.muteBtn.textContent='🎤';els.deafenBtn.classList.remove('off');els.deafenBtn.textContent='🎧';els.cameraBtn.classList.remove('off');els.screenBtn.classList.remove('off');state.ui.focusSharing=false;state.ui.showAllOverride=false}
function updateVoiceUI(){const connected=!!state.voice.channelId;els.voiceControls.classList.toggle('hidden',!connected);els.reconnectVoiceBtn.classList.toggle('hidden',!connected);els.hideCamsBtn.classList.toggle('hidden',!connected);if(connected){const s=state.servers.find(x=>x.id===state.voice.serverId),c=s?.channels.find(x=>x.id===state.voice.channelId);els.voiceChannelName.textContent=c?.name||'Voz'}const here=connected&&state.selectedChannel?.id===state.voice.channelId;els.joinVoiceBtn.textContent=here?'Sair da voz':'Entrar na voz';els.voiceSubtitle.textContent=here?`${state.voice.peers.size+1} conectado(s) · máximo 5`:'Conecte-se para conversar.';els.muteBtn.classList.toggle('off',state.voice.muted);els.muteBtn.textContent=state.voice.muted?'🔇':'🎤';applyFocusSharing()}
function applyFocusSharing(){const anyShare=!![...state.voice.peers.values()].find(p=>p.mediaState?.screen)||!!state.voice.screen;const focus=!state.ui.showAllOverride&&(state.ui.focusSharing||(state.ui.autoFocusShare&&anyShare));els.videoGrid.classList.toggle('focus-sharing',focus);els.hideCamsBtn.classList.toggle('active',focus);els.hideCamsBtn.textContent=focus?'👁 Mostrar todos':'👁 Focar tela'}

function expandCard(card){if(!card)return;if(document.fullscreenElement)document.exitFullscreen?.();else card.requestFullscreen?.().catch(()=>toast('Não consegui abrir em tela cheia.'))}
function wireExpand(card){if(card.dataset.expandReady)return;card.dataset.expandReady='1';card.querySelector('.expand-btn')?.addEventListener('click',e=>{e.stopPropagation();expandCard(card)});card.querySelector('.pin-btn')?.addEventListener('click',e=>{e.stopPropagation();const was=card.classList.contains('pinned');for(const c of els.videoGrid.querySelectorAll('.video-card'))c.classList.remove('pinned');card.classList.toggle('pinned',!was);els.videoGrid.classList.toggle('has-pin',!was)});card.addEventListener('dblclick',()=>{if(card.querySelector('video')?.style.display!=='none')expandCard(card)})}
