async function reconnectCurrentVoice(){if(!state.voice.channelId)return toast('Entre em uma sala de voz primeiro.');await rejoinVoiceTransport();toast('Reconectando voz…')}
function cleanupVoice(){clearInterval(state.voice.statsTimer);clearTimeout(state.voice.rejoinTimer);stopLocalVAD();clearPeersOnly();for(const stream of[state.voice.localAudio,state.voice.camera,state.voice.screen])stream?.getTracks().forEach(t=>t.stop());state.voice={channelId:null,serverId:null,localAudio:null,camera:null,screen:null,muted:false,deafened:false,speaking:false,pttHeld:false,peers:new Map(),statsTimer:null,vad:null,rejoinTimer:null};els.videoGrid.innerHTML='';els.videoGrid.classList.remove('focus-sharing','has-pin');els.voiceControls.classList.add('hidden');els.muteBtn.classList.remove('off');els.muteBtn.textContent='🎤';els.deafenBtn.classList.remove('off');els.deafenBtn.textContent='🎧';els.cameraBtn.classList.remove('off');els.screenBtn.classList.remove('off');state.ui.focusSharing=false;state.ui.showAllOverride=false}
function updateVoiceUI(){const connected=!!state.voice.channelId;els.voiceControls.classList.toggle('hidden',!connected);els.reconnectVoiceBtn.classList.toggle('hidden',!connected);els.hideCamsBtn.classList.toggle('hidden',!connected);if(connected){const s=state.servers.find(x=>x.id===state.voice.serverId),c=s?.channels.find(x=>x.id===state.voice.channelId);els.voiceChannelName.textContent=c?.name||'Voz'}const here=connected&&state.selectedChannel?.id===state.voice.channelId;els.joinVoiceBtn.textContent=here?'Sair da voz':'Entrar na voz';els.voiceSubtitle.textContent=here?`${state.voice.peers.size+1} conectado(s) · máximo 5`:'Conecte-se para conversar.';els.muteBtn.classList.toggle('off',state.voice.muted);els.muteBtn.textContent=state.voice.muted?'🔇':'🎤';applyFocusSharing()}
function applyFocusSharing(){const anyShare=!![...state.voice.peers.values()].find(p=>p.mediaState?.screen)||!!state.voice.screen;const focus=!state.ui.showAllOverride&&(state.ui.focusSharing||(state.ui.autoFocusShare&&anyShare));els.videoGrid.classList.toggle('focus-sharing',focus);els.hideCamsBtn.classList.toggle('active',focus);els.hideCamsBtn.textContent=focus?'👁 Mostrar todos':'👁 Focar tela'}

function expandCard(card){if(!card)return;if(document.fullscreenElement)document.exitFullscreen?.();else card.requestFullscreen?.().catch(()=>toast('Não consegui abrir em tela cheia.'))}
function wireExpand(card){if(card.dataset.expandReady)return;card.dataset.expandReady='1';card.querySelector('.expand-btn')?.addEventListener('click',e=>{e.stopPropagation();expandCard(card)});card.querySelector('.pin-btn')?.addEventListener('click',e=>{e.stopPropagation();const was=card.classList.contains('pinned');for(const c of els.videoGrid.querySelectorAll('.video-card'))c.classList.remove('pinned');card.classList.toggle('pinned',!was);els.videoGrid.classList.toggle('has-pin',!was)});card.addEventListener('dblclick',()=>{if(card.querySelector('video')?.style.display!=='none')expandCard(card)})}
function addLocalCard(){let card=$('video-local');if(!card){card=document.createElement('div');card.className='video-card';card.id='video-local';card.innerHTML='<div class="video-placeholder"><div class="avatar-video">🍌</div></div><video autoplay muted playsinline></video><button class="expand-btn hidden" title="Tela cheia">⛶</button><button class="pin-btn" title="Fixar">📌</button><div class="video-label">Você</div><div class="peer-stats">local</div>';els.videoGrid.prepend(card);wireExpand(card)}updateLocalVideo();setCardSpeaking('video-local',state.voice.speaking);refreshStatsVisibility()}
function updateLocalVideo(){const card=$('video-local');if(!card)return;const video=card.querySelector('video'),ph=card.querySelector('.video-placeholder'),exp=card.querySelector('.expand-btn'),stream=state.voice.screen||state.voice.camera;video.srcObject=stream||null;video.style.display=stream?'block':'none';ph.style.display=stream?'none':'grid';exp?.classList.toggle('hidden',!stream);card.classList.toggle('is-sharing',!!state.voice.screen);card.querySelector('.video-label').textContent=state.voice.screen?'Você · compartilhando tela':state.voice.muted?'Você · 🔇':'Você';applyFocusSharing()}
async function toggleCamera(){if(!state.voice.channelId)return;if(state.voice.camera){state.voice.camera.getTracks().forEach(t=>t.stop());state.voice.camera=null;if(!state.voice.screen)await setOutgoingVideo(null);updateLocalVideo();els.cameraBtn.classList.add('off');emitMediaState();return}try{state.voice.camera=await navigator.mediaDevices.getUserMedia({video:cameraConstraints(),audio:false});els.cameraBtn.classList.remove('off');if(!state.voice.screen)await setOutgoingVideo(state.voice.camera.getVideoTracks()[0]);updateLocalVideo();emitMediaState()}catch{toast('Não consegui abrir sua câmera.')}}
async function toggleScreen(){if(!state.voice.channelId)return;if(state.voice.screen)return stopScreen();try{const q=resolutionFor(state.media.screenQuality),stream=await navigator.mediaDevices.getDisplayMedia({video:{width:{ideal:q.width},height:{ideal:q.height},frameRate:{ideal:state.media.screenFps,max:state.media.screenFps}},audio:{restrictOwnAudio:true,suppressLocalAudioPlayback:false}});state.voice.screen=stream;els.screenBtn.classList.add('off');const vt=stream.getVideoTracks()[0];vt.contentHint=state.media.streamPreset==='smooth'?'motion':'detail';vt.onended=stopScreen;await setOutgoingVideo(vt);await syncSystemAudio();updateLocalVideo();emitMediaState();if(!stream.getAudioTracks().length)toast('Tela compartilhada. Esta fonte não forneceu áudio do sistema.',3500)}catch(e){if(e?.name!=='NotAllowedError')toast('Não consegui compartilhar a tela.')}}
async function stopScreen(){if(!state.voice.screen)return;const old=state.voice.screen;state.voice.screen=null;old.getTracks().forEach(t=>t.stop());els.screenBtn.classList.remove('off');await setOutgoingVideo(state.voice.camera?.getVideoTracks()[0]||null);await syncSystemAudio();updateLocalVideo();emitMediaState()}
function streamBitrate(){if(!state.voice.screen)return 2600000;return{economy:2500000,smooth:6000000,quality:8000000,auto:5000000}[state.media.streamPreset]||5000000}
async function tuneSender(sender,kind){try{const p=sender.getParameters();p.encodings=p.encodings?.length?p.encodings:[{}];if(kind==='audio')p.encodings[0].maxBitrate=96000;else{p.encodings[0].maxBitrate=streamBitrate();p.encodings[0].maxFramerate=state.voice.screen?state.media.screenFps:state.media.cameraFps;p.degradationPreference=state.voice.screen&&state.media.streamPreset==='smooth'?'maintain-framerate':'maintain-resolution';try{p.encodings[0].priority=state.voice.screen?'high':'medium';p.encodings[0].networkPriority=state.voice.screen?'high':'medium'}catch{}}await sender.setParameters(p)}catch{}}
async function setOutgoingVideo(track){for(const p of state.voice.peers.values()){let sender=p.pc.getSenders().find(s=>s._bananaVideo);if(sender){await sender.replaceTrack(track);await tuneSender(sender,'video')}else if(track){sender=p.pc.addTrack(track,state.voice.screen||state.voice.camera);sender._bananaVideo=true;await tuneSender(sender,'video');await renegotiate(p)}}}
async function syncSystemAudio(){const track=state.voice.screen?.getAudioTracks()[0]||null;for(const p of state.voice.peers.values()){let sender=p.pc.getSenders().find(s=>s._bananaSystemAudio);if(sender)await sender.replaceTrack(track);else if(track){sender=p.pc.addTrack(track,state.voice.screen);sender._bananaSystemAudio=true;await tuneSender(sender,'audio');await renegotiate(p)}}}
function addLocalTracksToPeer(peer){for(const t of state.voice.localAudio?.getAudioTracks()||[]){const s=peer.pc.addTrack(t,state.voice.localAudio);s._bananaMic=true;tuneSender(s,'audio')}const v=(state.voice.screen||state.voice.camera)?.getVideoTracks()[0];if(v){const s=peer.pc.addTrack(v,state.voice.screen||state.voice.camera);s._bananaVideo=true;tuneSender(s,'video')}const sa=state.voice.screen?.getAudioTracks()[0];if(sa){const s=peer.pc.addTrack(sa,state.voice.screen);s._bananaSystemAudio=true;tuneSender(s,'audio')}}
async function createPeer(socketId,user,initiator,mediaState={}){if(state.voice.peers.has(socketId))return state.voice.peers.get(socketId);const pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun1.l.google.com:19302'}]});const remoteStream=new MediaStream();const peer={socketId,user,pc,remoteStream,mediaState:mediaState||{},speaking:false,makingOffer:false,ignoreOffer:false,pendingCandidates:[],initiator,_lastBytes:0,_lastStatsAt:0,_disconnectTimer:null};state.voice.peers.set(socketId,peer);addLocalTracksToPeer(peer);pc.onicecandidate=e=>{if(e.candidate)state.socket.emit('webrtc:signal',{targetSocketId:socketId,data:{candidate:e.candidate}})};pc.ontrack=e=>{e.track.enabled=true;if(!remoteStream.getTracks().some(t=>t.id===e.track.id))remoteStream.addTrack(e.track);e.track.onended=()=>addRemoteCard(peer);e.track.onmute=()=>addRemoteCard(peer);e.track.onunmute=()=>addRemoteCard(peer);addRemoteCard(peer)};pc.onconnectionstatechange=()=>{clearTimeout(peer._disconnectTimer);if(pc.connectionState==='failed'){try{pc.restartIce()}catch{}renegotiate(peer)}else if(pc.connectionState==='disconnected'){peer._disconnectTimer=setTimeout(()=>{if(pc.connectionState==='disconnected'){try{pc.restartIce()}catch{}renegotiate(peer)}},4000)}else if(pc.connectionState==='closed')removePeer(socketId);addRemoteCard(peer)};pc.oniceconnectionstatechange=()=>addRemoteCard(peer);pc.onnegotiationneeded=async()=>{if(!peer.initiator&&!pc.remoteDescription)return;await renegotiate(peer)};addRemoteCard(peer);if(initiator)await renegotiate(peer);updateVoiceUI();return peer}
async function renegotiate(peer){if(!peer||peer.pc.signalingState==='closed'||peer.makingOffer||!state.socket?.connected)return;try{peer.makingOffer=true;await peer.pc.setLocalDescription(await peer.pc.createOffer());state.socket.emit('webrtc:signal',{targetSocketId:peer.socketId,data:{description:peer.pc.localDescription}})}catch(e){console.warn('offer',e)}finally{peer.makingOffer=false}}
async function handleSignal(socketId,user,data){let peer=state.voice.peers.get(socketId);if(!peer)peer=await createPeer(socketId,user,false,{});const pc=peer.pc;try{if(data.description){const desc=data.description,collision=desc.type==='offer'&&(peer.makingOffer||pc.signalingState!=='stable'),polite=String(state.socket.id)>String(socketId);peer.ignoreOffer=!polite&&collision;if(peer.ignoreOffer)return;if(collision&&polite)await pc.setLocalDescription({type:'rollback'});await pc.setRemoteDescription(desc);for(const c of peer.pendingCandidates.splice(0)){try{await pc.addIceCandidate(c)}catch{}}if(desc.type==='offer'){await pc.setLocalDescription(await pc.createAnswer());state.socket.emit('webrtc:signal',{targetSocketId:socketId,data:{description:pc.localDescription}})}}else if(data.candidate){if(pc.remoteDescription)await pc.addIceCandidate(data.candidate);else peer.pendingCandidates.push(data.candidate)}}catch(e){console.error('WebRTC signal error',e)}}
