:root{--bg:#111214;--panel:#18191c;--panel2:#202225;--panel3:#282a2e;--line:#303238;--text:#f2f3f5;--muted:#a7abb4;--yellow:#f3c623;--yellow2:#d6aa0a;--green:#23a55a;--red:#da373c;--blue:#5865f2}*{box-sizing:border-box}html,body{margin:0;height:100%;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text);overflow:hidden}button,input{font:inherit}button{border:0;cursor:pointer}.hidden{display:none!important}.setup{height:100%;display:grid;place-items:center;background:radial-gradient(circle at 50% 20%,#292515,#111214 46%)}.setup-card{width:min(510px,92vw);background:#18191c;border:1px solid #303238;border-radius:18px;padding:28px;box-shadow:0 24px 80px #0008}.brand{display:flex;gap:16px;align-items:center;margin-bottom:22px}.logo{font-size:52px}.setup h1{margin:0;font-size:30px}.setup p{margin:4px 0;color:var(--muted)}label{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:#c7cad1;font-weight:700;display:block;margin:14px 0 7px}input{width:100%;background:#0f1012;color:var(--text);border:1px solid #34363d;border-radius:9px;padding:12px;outline:none}input:focus{border-color:var(--yellow)}.setup button,.modal-card button:not(.modal-close),.voice-top button,.composer button{width:100%;background:var(--yellow);color:#1a1605;font-weight:800;border-radius:9px;padding:12px;margin-top:10px}.setup button:hover,.modal-card button:not(.modal-close):hover,.voice-top button:hover,.composer button:hover{background:#ffd83d}.setup button:disabled{opacity:.55;cursor:wait}.setup .primary{font-size:16px}.divider{display:flex;align-items:center;gap:10px;color:#747882;margin:13px 0}.divider:before,.divider:after{content:"";height:1px;background:#34363d;flex:1}.setup details{margin-top:15px;color:var(--muted);font-size:13px}.setup details summary{cursor:pointer}.setup details input{margin-top:9px}.hint{display:block;color:#777b84;margin-top:14px}.host-progress{margin-top:14px;background:#202225;border-radius:9px;padding:11px;color:#dfe1e5}.app{height:100%;display:grid;grid-template-columns:72px 250px minmax(420px,1fr) 220px;background:var(--bg)}.servers{background:#0d0e10;padding:12px 8px;display:flex;flex-direction:column;align-items:center;gap:9px;overflow-y:auto}.server-icon{width:48px;height:48px;border-radius:50%;background:#24262a;color:#e5e7eb;font-weight:800;transition:.15s}.server-icon:hover,.server-icon.active{border-radius:15px;background:var(--yellow);color:#161200}.server-icon.add{color:var(--green);font-size:24px}.sidebar{background:var(--panel);min-width:0;display:flex;flex-direction:column}.server-title{height:52px;border-bottom:1px solid #0f1012;padding:0 13px;display:flex;align-items:center;justify-content:space-between}.icon-btn{background:transparent;color:#b7bac2;font-size:18px;padding:7px;border-radius:7px}.icon-btn:hover{background:#2a2c31;color:#fff}.channels{padding:12px 8px;overflow:auto;flex:1}.channel-section{margin-bottom:15px}.channel-section-title{display:flex;justify-content:space-between;align-items:center;text-transform:uppercase;font-size:11px;color:#8d919a;font-weight:800;padding:0 5px 5px}.channel-add{background:transparent;color:#9ba0aa;font-size:18px}.channel{display:flex;width:100%;align-items:center;gap:8px;background:transparent;color:#9ea2aa;padding:8px;border-radius:6px;text-align:left}.channel:hover,.channel.active{background:#292b30;color:#f1f2f4}.channel .symbol{width:20px}.voice-users{font-size:11px;color:#747982;padding:1px 0 5px 35px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.voice-controls{background:#15171a;border-top:1px solid #0f1012;padding:10px}.voice-state{display:flex;gap:8px;align-items:center;margin-bottom:9px}.voice-state .dot{width:9px;height:9px;border-radius:50%;background:var(--green)}.voice-state div{display:flex;flex-direction:column}.voice-state b{font-size:12px;color:#67d88d}.voice-state small{color:#a1a5ad}.control-row{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.control-row button{background:#2b2d32;color:#fff;padding:8px;border-radius:7px}.control-row button.off{background:#523034}.control-row .danger{background:#4d2528}.profile-bar{height:58px;background:#121316;display:flex;align-items:center;padding:7px;gap:8px}.avatar{width:38px;height:38px;flex:none;border-radius:50%;display:grid;place-items:center;background:#4e525a;background-size:cover;background-position:center;font-weight:800}.profile-text{min-width:0;flex:1;display:flex;flex-direction:column}.profile-text b{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.profile-text small{color:#8f949e;font-size:11px}.online-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green)}.main{min-width:0;display:flex;flex-direction:column;background:#1d1f22}.main header{height:52px;border-bottom:1px solid #111214;display:flex;align-items:center;gap:9px;padding:0 16px}.main header span:first-child{color:#999da6;font-size:24px}.main header #channelDesc{color:#777c85;font-size:13px;border-left:1px solid #3a3c42;padding-left:12px}.connection-badge{margin-left:auto!important;font-size:11px!important;color:#68d391!important;border:1px solid #345f42!important;border-radius:999px;padding:3px 7px!important}.connection-badge.offline{color:#ff9498!important;border-color:#754044!important}.empty-view{flex:1;display:grid;place-content:center;text-align:center;color:#8c919b}.big-banana{font-size:70px}.empty-view h2{color:#f0f1f2;margin:8px 0}.text-view{min-height:0;flex:1;display:flex;flex-direction:column}.messages{flex:1;overflow-y:auto;padding:18px 20px}.message{display:grid;grid-template-columns:42px 1fr;gap:10px;padding:7px 0}.message:hover{background:#202225}.message .avatar{width:40px;height:40px}.msg-head{display:flex;align-items:baseline;gap:7px}.msg-head b{font-size:14px}.msg-head small{font-size:10px;color:#777c84}.msg-text{color:#d7d9de;white-space:pre-wrap;word-break:break-word;font-size:14px;margin-top:2px}.composer{display:flex;gap:8px;padding:0 18px 18px}.composer input{background:#2b2d31}.composer button{width:auto;padding:0 18px;margin:0}.members{background:#18191c;padding:18px 10px;overflow:auto}.members h3{text-transform:uppercase;font-size:11px;color:#8f939b;margin:0 6px 12px}.member{display:flex;align-items:center;gap:9px;padding:7px;border-radius:6px}.member .avatar{width:32px;height:32px}.member-name{min-width:0}.member-name b{display:block;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.member-name small{font-size:10px;color:#777b83}.member.offline{opacity:.45}.voice-view{flex:1;min-height:0;display:flex;flex-direction:column}.voice-top{padding:18px 20px;display:flex;justify-content:space-between;align-items:center}.voice-top h2{margin:0}.voice-top p{margin:4px 0 0;color:#888d96}.voice-top button{width:auto;margin:0}.video-grid{padding:10px 20px 20px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;overflow:auto}.video-card{position:relative;min-height:220px;background:#111214;border-radius:12px;overflow:hidden;border:1px solid #2c2f34}.video-card video{width:100%;height:100%;object-fit:contain;background:#08090a}.video-placeholder{height:100%;min-height:220px;display:grid;place-items:center;font-size:54px}.video-label{position:absolute;bottom:8px;left:8px;background:#000a;padding:5px 8px;border-radius:6px;font-size:12px}.peer-stats{position:absolute;top:8px;right:8px;background:#0009;padding:4px 7px;border-radius:6px;font-size:10px;color:#dfe1e5}.modal{position:fixed;inset:0;background:#0009;display:grid;place-items:center;z-index:20}.modal-card{width:min(480px,92vw);max-height:88vh;overflow:auto;background:#202225;border:1px solid #35373c;border-radius:14px;padding:24px;position:relative}.modal-card h2{margin-top:0}.modal-card p,.modal-card small{color:#a5a9b1}.modal-card input{margin:5px 0 10px}.modal-close{position:absolute;right:12px;top:10px;background:transparent;color:#aaa;font-size:26px}.modal-split{display:grid;grid-template-columns:1fr 1fr;gap:10px}.invite-box{background:#111214;border:1px solid #34363d;border-radius:8px;padding:10px;word-break:break-all;font-family:Consolas,monospace;font-size:12px;color:#e9eaed}.toast{position:fixed;z-index:50;left:50%;bottom:24px;transform:translateX(-50%);background:#08090aeF;border:1px solid #3c3f45;padding:10px 15px;border-radius:9px;box-shadow:0 12px 30px #0008}@media(max-width:1050px){.app{grid-template-columns:66px 230px minmax(380px,1fr)}.members{display:none}}@media(max-width:800px){.app{grid-template-columns:62px 210px minmax(320px,1fr)}.video-grid{grid-template-columns:1fr}}
