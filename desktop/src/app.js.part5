  const showVideo=async()=>{stopMicTest();activate('tabVideo');area.innerHTML=`<div class="audio-settings"><label>Câmera</label><select id="cameraSelect"><option>Carregando…</option></select><div class="settings-2col"><div><label>Qualidade da câmera</label><select id="cameraQuality"><option value="480">480p</option><option value="720">720p</option><option value="1080">1080p</option></select></div><div><label>FPS da câmera</label><select id="cameraFps"><option value="30">30 FPS</option><option value="60">60 FPS</option></select></div></div><button class="secondary" id="testCameraBtn">📹 Testar câmera</button><video id="cameraPreview" class="camera-preview" autoplay muted playsinline></video><hr class="settings-sep"><label>Perfil de compartilhamento</label><select id="streamPreset"><option value="auto">Automático (recomendado)</option><option value="quality">Qualidade</option><option value="smooth">Fluidez</option><option value="economy">Economia de banda</option></select><div class="settings-2col"><div><label>Qualidade da tela</label><select id="screenQuality"><option value="720">720p</option><option value="1080">1080p</option></select></div><div><label>FPS da tela</label><select id="screenFps"><option value="30">30 FPS</option><option value="60">60 FPS</option></select></div></div><div class="switch-grid"><label class="switch-line"><input id="autoFocusShare" type="checkbox" ${state.ui.autoFocusShare?'checked':''}> Focar tela compartilhada</label><label class="switch-line"><input id="showStats" type="checkbox" ${state.ui.showStats?'checked':''}> Mostrar ping/bitrate</label></div><div class="settings-help">Qualidade prioriza nitidez. Fluidez prioriza FPS. Economia reduz uso de upload. Durante compartilhamento, a câmera deixa de ser enviada para economizar recursos.</div><button class="action" id="saveVideoSettings">Salvar vídeo e tela</button></div>`;try{const d=await enumerateMediaDevices(false);fillDeviceSelect($('cameraSelect'),d,'videoinput',state.media.cameraId,'Câmera')}catch{}$('cameraQuality').value=state.media.cameraQuality;$('cameraFps').value=String(state.media.cameraFps);$('screenQuality').value=state.media.screenQuality;$('screenFps').value=String(state.media.screenFps);$('streamPreset').value=state.media.streamPreset;$('testCameraBtn').onclick=()=>cameraTest.stream?stopCameraTest():startCameraTest();$('saveVideoSettings').onclick=()=>{state.media.cameraId=$('cameraSelect').value;state.media.cameraQuality=$('cameraQuality').value;state.media.cameraFps=Number($('cameraFps').value);state.media.screenQuality=$('screenQuality').value;state.media.screenFps=Number($('screenFps').value);state.media.streamPreset=$('streamPreset').value;state.ui.autoFocusShare=$('autoFocusShare').checked;state.ui.showStats=$('showStats').checked;savePrefs();stopCameraTest();refreshStatsVisibility();closeModal();toast('Configurações de vídeo salvas.')};
  const showGeneral=()=>{stopMicTest();stopCameraTest();activate('tabGeneral');area.innerHTML=`<div class="audio-settings"><div class="switch-grid"><label class="switch-line"><input id="joinLeaveSounds" type="checkbox" ${state.ui.joinLeaveSounds?'checked':''}> Sons de entrada/saída</label><label class="switch-line"><input id="pttEnabled" type="checkbox" ${state.ui.pttEnabled?'checked':''}> Push-to-talk</label></div><label>Tecla do push-to-talk</label><button class="secondary" id="capturePttKey">${escapeHtml(prettyKey(state.ui.pttKey))}</button><div class="settings-help">O push-to-talk por tecla funciona enquanto o Banana Cord estiver em foco. Atalhos globais disponíveis mesmo durante o jogo: <b>Ctrl+Shift+M</b> mutar, <b>Ctrl+Shift+D</b> ensurdecer e <b>Ctrl+Shift+S</b> compartilhar tela.</div><button class="action" id="saveGeneral">Salvar geral</button></div>`;$('capturePttKey').onclick=()=>{const btn=$('capturePttKey');btn.textContent='Pressione uma tecla…';const handler=e=>{e.preventDefault();state.ui.pttKey=e.code;btn.textContent=prettyKey(e.code);window.removeEventListener('keydown',handler,true)};window.addEventListener('keydown',handler,true)};$('saveGeneral').onclick=()=>{state.ui.joinLeaveSounds=$('joinLeaveSounds').checked;state.ui.pttEnabled=$('pttEnabled').checked;savePrefs();applyMicTrackState();closeModal();toast('Configurações gerais salvas.')};
  const showDiag=()=>{stopMicTest();stopCameraTest();activate('tabDiag');area.innerHTML=diagnosticsHtml();$('refreshDiag').onclick=showDiag;$('reconnectVoice').onclick=async()=>{await reconnectCurrentVoice();showDiag()}};
  const showUpdates=async()=>{
    stopMicTest();stopCameraTest();activate('tabUpdates');
    let cfg=state.updates.config||{},ust=state.updates.state||{};
    try{cfg=await ipcRenderer.invoke('update:get-config');ust=await ipcRenderer.invoke('update:get-state');state.updates.config=cfg;state.updates.state=ust}catch{}
