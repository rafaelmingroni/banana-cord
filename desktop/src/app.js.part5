async function startMicTest(){stopMicTest();try{const c={echoCancellation:$('echoCancellation')?.checked??state.media.echoCancellation,noiseSuppression:$('noiseSuppression')?.checked??state.media.noiseSuppression,autoGainControl:$('autoGainControl')?.checked??state.media.autoGainControl,channelCount:1};const selected=$('micSelect')?.value||state.media.micId;if(selected)c.deviceId={exact:selected};const stream=await navigator.mediaDevices.getUserMedia({audio:c,video:false});const ctx=new AudioContext(),source=ctx.createMediaStreamSource(stream),analyser=ctx.createAnalyser();analyser.fftSize=512;source.connect(analyser);const data=new Uint8Array(analyser.frequencyBinCount);const opts=typeof MediaRecorder!=='undefined'&&MediaRecorder.isTypeSupported?.('audio/webm;codecs=opus')?{mimeType:'audio/webm;codecs=opus'}:{};const recorder=new MediaRecorder(stream,opts);const test={stream,ctx,raf:null,recorder,chunks:[],url:'',audio:null,timer:null,discarding:false};micTest=test;recorder.ondataavailable=e=>{if(e.data?.size)test.chunks.push(e.data)};recorder.onstop=()=>{cleanupMicLive(test);if(test.discarding)return;const blob=new Blob(test.chunks,{type:recorder.mimeType||'audio/webm'});if(!blob.size){if($('micTestState'))$('micTestState').textContent='Não consegui gerar a gravação. Tente novamente.';return}test.url=URL.createObjectURL(blob);test.recorder=null;if($('micLevelBar'))$('micLevelBar').style.width='0%';if($('micTestState'))$('micTestState').textContent='Gravação pronta. Clique em “Ouvir gravação”.';if($('testMicBtn'))$('testMicBtn').textContent='● Gravar novamente';if($('playMicBtn'))$('playMicBtn').classList.remove('hidden')};recorder.start(150);$('micTestState').textContent='Gravando… fale normalmente. O teste para sozinho em até 8 segundos.';$('testMicBtn').textContent='■ Parar gravação';const tick=()=>{analyser.getByteTimeDomainData(data);let sum=0;for(const v of data){const n=(v-128)/128;sum+=n*n}const level=Math.min(100,Math.round(Math.sqrt(sum/data.length)*360));if($('micLevelBar'))$('micLevelBar').style.width=`${level}%`;test.raf=requestAnimationFrame(tick)};tick();test.timer=setTimeout(finishMicRecording,8000)}catch{toast('Não consegui acessar esse microfone. Confira a permissão do Windows.',4000)}}
async function playMicRecording(){if(!micTest.url)return;if(micTest.audio&&!micTest.audio.paused){stopMicPlayback();if($('micTestState'))$('micTestState').textContent='Reprodução parada.';return}try{const audio=new Audio(micTest.url);audio.volume=Math.min(1,Math.max(0,Number($('outputVolume')?.value??state.media.outputVolume)));const sink=$('speakerSelect')?.value||state.media.speakerId;if(sink&&typeof audio.setSinkId==='function')await audio.setSinkId(sink);micTest.audio=audio;$('playMicBtn').textContent='■ Parar reprodução';$('micTestState').textContent='Reproduzindo sua gravação…';audio.onended=()=>{if(micTest.audio===audio)micTest.audio=null;if($('playMicBtn'))$('playMicBtn').textContent='▶ Ouvir gravação';if($('micTestState'))$('micTestState').textContent='Gravação pronta. Você pode ouvir novamente ou gravar outra.'};await audio.play()}catch{toast('Não consegui reproduzir a gravação nessa saída.',3500)}}
async function testSpeaker(){try{const ctx=new AudioContext(),osc=ctx.createOscillator(),gain=ctx.createGain(),dest=ctx.createMediaStreamDestination();osc.frequency.value=523.25;gain.gain.value=.12;osc.connect(gain).connect(dest);osc.start();const audio=new Audio();audio.srcObject=dest.stream;audio.volume=Math.min(1,Math.max(0,Number($('outputVolume')?.value??state.media.outputVolume)));const sink=$('speakerSelect')?.value||state.media.speakerId;if(sink&&typeof audio.setSinkId==='function')await audio.setSinkId(sink);await audio.play();setTimeout(()=>{try{osc.stop();audio.pause();ctx.close()}catch{}},700)}catch{toast('Não consegui tocar o som de teste nessa saída.',3500)}}
let cameraTest={stream:null};function stopCameraTest(){cameraTest.stream?.getTracks().forEach(t=>t.stop());cameraTest={stream:null};if($('cameraPreview'))$('cameraPreview').srcObject=null;if($('testCameraBtn'))$('testCameraBtn').textContent='📹 Testar câmera'}
async function startCameraTest(){stopCameraTest();try{const q=resolutionFor($('cameraQuality')?.value||state.media.cameraQuality),fps=Number($('cameraFps')?.value||state.media.cameraFps),c={width:{ideal:q.width},height:{ideal:q.height},frameRate:{ideal:fps,max:fps}};const id=$('cameraSelect')?.value||state.media.cameraId;if(id)c.deviceId={exact:id};cameraTest.stream=await navigator.mediaDevices.getUserMedia({video:c,audio:false});const v=$('cameraPreview');v.srcObject=cameraTest.stream;v.play().catch(()=>{});$('testCameraBtn').textContent='⏹ Parar câmera'}catch{toast('Não consegui abrir essa câmera.',3500)}}
async function refreshAllOutputs(){for(const p of state.voice.peers.values())await applyOutputDevice($(`video-${p.socketId}`)?.querySelector('audio.remote-audio'),p.user?.id||'')}
async function switchMicrophoneInCall(){if(!state.voice.channelId)return;let stream;try{stream=await navigator.mediaDevices.getUserMedia({audio:micConstraints(),video:false})}catch{return toast('Não consegui trocar o microfone durante a chamada.',4000)}const track=stream.getAudioTracks()[0];const old=state.voice.localAudio;state.voice.localAudio=stream;applyMicTrackState();for(const p of state.voice.peers.values()){let sender=p.pc.getSenders().find(s=>s._bananaMic);if(sender)await sender.replaceTrack(track);else{sender=p.pc.addTrack(track,stream);sender._bananaMic=true;await renegotiate(p)}}old?.getTracks().forEach(t=>t.stop());startLocalVAD();toast('Microfone atualizado na chamada.')}

function diagnosticsHtml(){const peers=[...state.voice.peers.values()];const rows=peers.length?peers.map(p=>`<div class="diag-row"><b>${escapeHtml(p.user?.name||'Amigo')}</b><span>WebRTC: ${escapeHtml(p.pc.connectionState||'novo')} · ICE: ${escapeHtml(p.pc.iceConnectionState||'novo')} · áudio ${p.remoteStream.getAudioTracks().filter(t=>t.readyState==='live').length} · vídeo ${p.remoteStream.getVideoTracks().filter(t=>t.readyState==='live').length}</span></div>`).join(''):'<p><small>Você não está conectado a outras pessoas em uma sala de voz.</small></p>';return`<div class="diagnostics"><div class="diag-row"><b>Servidor</b><span>${escapeHtml(state.serverUrl||'--')}</span></div><div class="diag-row"><b>Ping do servidor</b><span>${escapeHtml(els.ping.textContent||'--')}</span></div><div class="diag-row"><b>Sala de voz</b><span>${state.voice.channelId?'Conectado':'Fora da voz'}</span></div>${rows}<div class="settings-actions"><button class="secondary" id="refreshDiag">Atualizar diagnóstico</button><button class="secondary" id="reconnectVoice">Reconectar voz</button></div></div>`}
async function openSettings(){
  stopMicTest();stopCameraTest();
  const nav=[['tabProfile','👤','Perfil','Nome, foto e presença'],['tabAudio','🎙','Áudio','Microfone e saída'],['tabVideo','🖥','Vídeo e tela','Câmera e compartilhamento'],['tabGeneral','⌨','Geral','Atalhos e comportamento'],['tabDiag','◉','Diagnóstico','Conexão e WebRTC'],['tabUpdates','↻','Atualizações','Versões do Banana Cord']];
  openModal(`<div class="settings-shell"><aside class="settings-nav"><div class="settings-brand"><div class="settings-banana">🍌</div><div><b>Banana Cord</b><small>Configurações</small></div></div><div class="settings-nav-list">${nav.map(([id,icon,label])=>`<button id="${id}" class="settings-nav-item"><span>${icon}</span><b>${label}</b></button>`).join('')}</div><div class="settings-nav-foot">v${escapeHtml(state.updates.config?.currentVersion||'0.10.0')}</div></aside><section class="settings-content"><div class="settings-content-head"><span>CONFIGURAÇÕES</span><h2 id="settingsTitle">Perfil</h2><p id="settingsSubtitle">Nome, foto e presença</p></div><div id="settingsArea"></div></section></div>`);
  els.modal.querySelector('.modal-card')?.classList.add('settings-modal');
  const area=$('settingsArea');
  const meta=Object.fromEntries(nav.map(([id,_icon,label,sub])=>[id,[label,sub]]));
  const activate=id=>{for(const [x] of nav)$(x)?.classList.toggle('active',x===id);const [title,sub]=meta[id]||['Configurações',''];if($('settingsTitle'))$('settingsTitle').textContent=title;if($('settingsSubtitle'))$('settingsSubtitle').textContent=sub};
  const showProfile=()=>{stopMicTest();stopCameraTest();activate('tabProfile');area.innerHTML=`<div class="settings-card"><div class="settings-card-head"><div><span class="settings-kicker">IDENTIDADE</span><h3>Seu perfil</h3><p>Como seus amigos veem você dentro do Banana Cord.</p></div><div id="settingsAvatarPreview" class="avatar settings-avatar"></div></div><div class="settings-form-grid"><div class="settings-field"><label>Nome</label><input id="profileName" maxlength="32" value="${escapeHtml(state.user?.name||'')}"></div><div class="settings-field"><label>Status</label><select id="profileStatus" class="profile-status-select"><option value="online">Online</option><option value="busy">Ocupado</option><option value="away">Ausente</option></select></div></div><div class="settings-field"><label>Foto de perfil</label><input id="profileFile" type="file" accept="image/png,image/jpeg,image/webp"><small>PNG, JPG ou WebP de até 900 KB.</small></div><div class="settings-actions"><button class="action" id="saveProfile">Salvar perfil</button></div></div><div class="settings-card settings-card-muted"><div class="settings-card-head compact"><div><span class="settings-kicker">CONEXÃO</span><h3>Sessão atual</h3><p class="settings-url">${escapeHtml(state.serverUrl||'Nenhum servidor conectado')}</p></div></div><button class="secondary" id="disconnectNow">Desconectar</button></div>`;$('profileStatus').value=state.user?.status==='offline'?'online':state.user?.status||state.ui.status;let avatarData=state.user?.avatar||'';avatarStyle($('settingsAvatarPreview'),state.user||{name:'Você',avatar:avatarData});$('profileFile').onchange=e=>{const file=e.target.files?.[0];if(!file)return;if(file.size>900000)return toast('Escolha uma imagem menor que 900 KB.');const r=new FileReader();r.onload=()=>{avatarData=r.result;avatarStyle($('settingsAvatarPreview'),{name:$('profileName').value||state.user?.name||'Você',avatar:avatarData})};r.readAsDataURL(file)};$('saveProfile').onclick=()=>{state.ui.status=$('profileStatus').value;savePrefs();state.socket.emit('profile:update',{name:$('profileName').value,avatar:avatarData,status:state.ui.status});closeModal()};$('disconnectNow').onclick=()=>location.reload()};
