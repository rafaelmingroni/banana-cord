els.addServerBtn.addEventListener('click',()=>openModal(`<h2>Servidor</h2><p>Crie um servidor privado ou entre com o código de um servidor deste mesmo host.</p><label>Nome do novo servidor</label><input id="newServerName" maxlength="40" placeholder="Banana Gang"><button id="createServerNow">Criar servidor</button><div class="divider"><span>ou</span></div><label>Código de convite</label><input id="joinCode" maxlength="16" placeholder="A1B2C3D4"><button id="joinServerNow">Entrar pelo código</button>`));
els.modalBody.addEventListener('click',e=>{if(e.target.id==='createServerNow'){const name=$('newServerName')?.value.trim();if(name)state.socket.emit('server:create',{name})}if(e.target.id==='joinServerNow'){const inviteCode=$('joinCode')?.value.trim();if(inviteCode)state.socket.emit('server:join',{inviteCode})}});
function channelModal(type){openModal(`<h2>Novo canal ${type==='voice'?'de voz':'de texto'}</h2><label>Nome</label><input id="newChannelName" maxlength="32" placeholder="${type==='voice'?'Jogando':'jogos'}"><button id="createChannelNow">Criar canal</button>`);$('createChannelNow').addEventListener('click',()=>{const name=$('newChannelName').value.trim();if(name){state.socket.emit('channel:create',{serverId:state.selectedServer.id,type,name});closeModal()}})}
function editChannelModal(c){openModal(`<h2>Editar canal</h2><label>Nome</label><input id="editChannelName" maxlength="32" value="${escapeHtml(c.name)}"><button id="saveChannelName">Salvar nome</button><hr class="settings-sep"><button id="deleteChannel" class="danger-action">Excluir canal</button><p><small>Você pode arrastar canais na lateral para reordená-los.</small></p>`);$('saveChannelName').onclick=()=>{const name=$('editChannelName').value.trim();if(name)state.socket.emit('channel:update',{serverId:state.selectedServer.id,channelId:c.id,name});closeModal()};$('deleteChannel').onclick=()=>{if(confirm(`Excluir #${c.name}?`)){state.socket.emit('channel:update',{serverId:state.selectedServer.id,channelId:c.id,action:'delete'});closeModal()}}}
els.inviteBtn.addEventListener('click',openInviteModal);async function openInviteModal(){if(!state.selectedServer)return;const url=state.isHost?(state.publicHostUrl||state.serverUrl):state.serverUrl;const full=makeInvite(url,state.selectedServer.inviteCode);openModal(`<h2>Convidar para ${escapeHtml(state.selectedServer.name)}</h2><p>Seu amigo instala o Banana Cord e cola este convite na primeira tela:</p><div class="invite-box">${escapeHtml(full)}</div><button id="copyInvite">Copiar convite</button><p><small>Código: <b>${escapeHtml(state.selectedServer.inviteCode)}</b></small></p>${can('admin')?'<button id="regenInvite" class="secondary">Gerar novo código</button>':''}`);$('copyInvite').onclick=copyCurrentInvite;if($('regenInvite'))$('regenInvite').onclick=()=>state.socket.emit('server:regenerate-invite',{serverId:state.selectedServer.id})}
async function copyCurrentInvite(){if(!state.selectedServer)return;const url=state.isHost?(state.publicHostUrl||state.serverUrl):state.serverUrl;await ipcRenderer.invoke('clipboard:write',makeInvite(url,state.selectedServer.inviteCode));toast('Convite copiado.');closeModal()}
els.serverSettingsBtn.addEventListener('click',openServerSettings);
function openServerSettings(){if(!state.selectedServer)return;const s=state.selectedServer;const r=currentRole();const rows=[...state.members.values()].map(u=>{const role=u.role||roleFor(u.id);const canEdit=r==='owner'&&u.id!==s.ownerId;return `<div class="role-row"><div class="avatar role-avatar" data-user="${escapeHtml(u.id)}"></div><div><b>${escapeHtml(u.name)}</b><small>${STATUS_LABEL[u.status||'offline']||'Offline'}</small></div>${canEdit?`<select class="role-select" data-user="${escapeHtml(u.id)}"><option value="member" ${role==='member'?'selected':''}>Membro</option><option value="moderator" ${role==='moderator'?'selected':''}>Moderador</option><option value="admin" ${role==='admin'?'selected':''}>Administrador</option></select><button class="remove-member" data-user="${escapeHtml(u.id)}">Remover</button>`:`<span class="role-badge role-${role}">${ROLE_LABEL[role]}</span><span></span>`}</div>`}).join('');openModal(`<h2>${escapeHtml(s.name)}</h2><div class="server-settings-grid">${can('admin')?`<label>Nome do servidor</label><input id="serverNameEdit" maxlength="40" value="${escapeHtml(s.name)}"><button id="saveServerName">Salvar nome</button>`:''}<div class="permission-note"><b>Cargos</b><br>Dono: tudo. Administrador: servidor, convites e canais. Moderador: criar, editar, apagar e ordenar canais. Membro: conversa e entra nas calls.</div><div class="role-table">${rows||'<p>Carregando membros…</p>'}</div><div class="version-label">Banana Cord v0.10</div></div>`);for(const el of document.querySelectorAll('.role-avatar'))avatarStyle(el,state.members.get(el.dataset.user));$('saveServerName')?.addEventListener('click',()=>{state.socket.emit('server:update',{serverId:s.id,name:$('serverNameEdit').value});closeModal()});for(const sel of document.querySelectorAll('.role-select'))sel.addEventListener('change',()=>state.socket.emit('member:set-role',{serverId:s.id,userId:sel.dataset.user,role:sel.value}));for(const b of document.querySelectorAll('.remove-member'))b.addEventListener('click',()=>{const u=state.members.get(b.dataset.user);if(confirm(`Remover ${u?.name||'membro'} do servidor?`)){state.socket.emit('member:kick',{serverId:s.id,userId:b.dataset.user});closeModal()}})}
function openMemberProfile(userId){const u=state.members.get(userId);if(!u)return;const role=u.role||roleFor(userId);const canDm=userId!==state.user?.id;openModal(`<h2>${escapeHtml(u.name)}</h2><div class="profile-preview"><div id="profilePreviewAvatar" class="avatar" style="width:76px;height:76px;font-size:28px"></div><p><span class="status-dot status-${escapeHtml(u.status||'offline')}"></span>${STATUS_LABEL[u.status||'offline']||'Offline'}</p><span class="role-badge role-${role}">${ROLE_LABEL[role]}</span>${canDm?'<button id="dmFromProfile" class="action">💬 Mensagem privada</button>':''}</div>`);avatarStyle($('profilePreviewAvatar'),u);$('dmFromProfile')?.addEventListener('click',()=>{closeModal();startDm(userId,u)})}
els.profileBtn.addEventListener('click',openSettings);els.updateBadge?.addEventListener('click',async()=>{if(state.updates.state?.status==='downloaded'){await ipcRenderer.invoke('update:install');return}await openSettings();setTimeout(()=>$('tabUpdates')?.click(),0)});

function micConstraints(){const base={echoCancellation:state.media.echoCancellation,noiseSuppression:state.media.noiseSuppression,autoGainControl:state.media.autoGainControl,channelCount:1};if(state.media.micId)base.deviceId={exact:state.media.micId};return base}
function resolutionFor(value){return value==='1080'?{width:1920,height:1080}:value==='480'?{width:854,height:480}:{width:1280,height:720}}
function cameraConstraints(){const q=resolutionFor(state.media.cameraQuality);const c={width:{ideal:q.width},height:{ideal:q.height},frameRate:{ideal:state.media.cameraFps,max:state.media.cameraFps}};if(state.media.cameraId)c.deviceId={exact:state.media.cameraId};return c}
function peerVolume(userId){const v=Number(state.media.peerVolumes?.[userId]);return Number.isFinite(v)?Math.min(1,Math.max(0,v)):1}
async function applyOutputDevice(mediaEl,userId=''){if(!mediaEl)return;const base=Math.min(1,Math.max(0,state.media.outputVolume||0));mediaEl.volume=state.voice.deafened?0:Math.min(1,base*peerVolume(userId));if(state.media.speakerId&&typeof mediaEl.setSinkId==='function'){try{await mediaEl.setSinkId(state.media.speakerId)}catch(e){console.warn('speaker output',e)}}}
async function enumerateMediaDevices(withPermission=false){let temp=null;if(withPermission){try{temp=await navigator.mediaDevices.getUserMedia({audio:true,video:false})}catch{}}const devices=await navigator.mediaDevices.enumerateDevices();temp?.getTracks().forEach(t=>t.stop());return devices}
function fillDeviceSelect(select,devices,kind,current,label){if(!select)return;const rows=devices.filter(d=>d.kind===kind);select.innerHTML='';const def=document.createElement('option');def.value='';def.textContent=`Padrão do Windows (${label})`;select.appendChild(def);rows.forEach((d,i)=>{const o=document.createElement('option');o.value=d.deviceId;o.textContent=d.label||`${label} ${i+1}`;select.appendChild(o)});select.value=rows.some(d=>d.deviceId===current)?current:''}

let micTest={stream:null,ctx:null,raf:null,recorder:null,chunks:[],url:'',audio:null,timer:null,discarding:false};
function cleanupMicLive(test){if(!test)return;if(test.raf)cancelAnimationFrame(test.raf);clearTimeout(test.timer);test.stream?.getTracks().forEach(t=>t.stop());try{test.ctx?.close()}catch{}test.stream=null;test.ctx=null;test.raf=null;test.timer=null}
function stopMicPlayback(){const a=micTest.audio;if(a){try{a.pause();a.currentTime=0}catch{}micTest.audio=null}if($('playMicBtn'))$('playMicBtn').textContent='▶ Ouvir gravação'}
function stopMicTest(){const test=micTest;test.discarding=true;stopMicPlayback();if(test.recorder?.state==='recording'){try{test.recorder.stop()}catch{}}cleanupMicLive(test);if(test.url){try{URL.revokeObjectURL(test.url)}catch{}}micTest={stream:null,ctx:null,raf:null,recorder:null,chunks:[],url:'',audio:null,timer:null,discarding:false};if($('micLevelBar'))$('micLevelBar').style.width='0%';if($('micTestState'))$('micTestState').textContent='Grave uma frase e depois ouça exatamente como seu microfone está saindo.';if($('testMicBtn'))$('testMicBtn').textContent='● Gravar teste';if($('playMicBtn'))$('playMicBtn').classList.add('hidden')}
function finishMicRecording(){const test=micTest;if(test.recorder?.state==='recording'){clearTimeout(test.timer);test.timer=null;try{test.recorder.stop()}catch{}}}
