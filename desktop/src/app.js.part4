  const showProfile=()=>{stopMicTest();stopCameraTest();activate('tabProfile');area.innerHTML=`<label>Nome</label><input id="profileName" maxlength="32" value="${escapeHtml(state.user?.name||'')}"><label>Status</label><select id="profileStatus" class="profile-status-select"><option value="online">Online</option><option value="busy">Ocupado</option><option value="away">Ausente</option></select><label>Foto de perfil</label><input id="profileFile" type="file" accept="image/png,image/jpeg,image/webp"><button class="action" id="saveProfile">Salvar perfil</button><hr class="settings-sep"><p><small>Servidor atual: ${escapeHtml(state.serverUrl)}</small></p><button class="secondary" id="disconnectNow">Desconectar</button>`;$('profileStatus').value=state.user?.status==='offline'?'online':state.user?.status||state.ui.status;let avatarData=state.user?.avatar||'';$('profileFile').onchange=e=>{const file=e.target.files?.[0];if(!file)return;if(file.size>900000)return toast('Escolha uma imagem menor que 900 KB.');const r=new FileReader();r.onload=()=>avatarData=r.result;r.readAsDataURL(file)};$('saveProfile').onclick=()=>{state.ui.status=$('profileStatus').value;savePrefs();state.socket.emit('profile:update',{name:$('profileName').value,avatar:avatarData,status:state.ui.status});closeModal()};$('disconnectNow').onclick=()=>location.reload()};
  const showAudio=async()=>{stopCameraTest();activate('tabAudio');area.innerHTML=`<div class="audio-settings"><label>Microfone</label><select id="micSelect"><option>Carregando…</option></select><button class="secondary" id="testMicBtn">🎤 Testar microfone</button><div class="mic-meter"><span id="micLevelBar"></span></div><small id="micTestState">Teste parado</small><label>Sensibilidade do indicador de voz <span id="thresholdLabel">${state.media.voiceThreshold}</span></label><input id="voiceThreshold" type="range" min="3" max="45" step="1" value="${state.media.voiceThreshold}"><div class="switch-grid"><label class="switch-line"><input id="echoCancellation" type="checkbox" ${state.media.echoCancellation?'checked':''}> Cancelamento de eco</label><label class="switch-line"><input id="noiseSuppression" type="checkbox" ${state.media.noiseSuppression?'checked':''}> Redução de ruído</label><label class="switch-line"><input id="autoGainControl" type="checkbox" ${state.media.autoGainControl?'checked':''}> Ganho automático</label><label class="switch-line"><input id="autoMute" type="checkbox" ${state.media.autoMute?'checked':''}> Entrar mutado</label></div><label>Saída de áudio / fone</label><select id="speakerSelect"><option>Carregando…</option></select><label>Volume geral <span id="volumeLabel">${Math.round(state.media.outputVolume*100)}%</span></label><input id="outputVolume" type="range" min="0" max="1" step="0.01" value="${state.media.outputVolume}"><button class="secondary" id="testSpeakerBtn">🔊 Testar saída</button><button class="action" id="saveAudioSettings">Salvar áudio</button><button class="secondary" id="refreshDevicesBtn">Atualizar dispositivos</button></div>`;const load=async()=>{try{const d=await enumerateMediaDevices(true);fillDeviceSelect($('micSelect'),d,'audioinput',state.media.micId,'Microfone');fillDeviceSelect($('speakerSelect'),d,'audiooutput',state.media.speakerId,'Saída')}catch{toast('Não consegui listar os dispositivos.')}};await load();$('testMicBtn').onclick=()=>micTest.stream?stopMicTest():startMicTest();$('testSpeakerBtn').onclick=testSpeaker;$('refreshDevicesBtn').onclick=load;$('voiceThreshold').oninput=e=>$('thresholdLabel').textContent=e.target.value;$('outputVolume').oninput=async e=>{state.media.outputVolume=Number(e.target.value);$('volumeLabel').textContent=`${Math.round(state.media.outputVolume*100)}%`;await refreshAllOutputs()};$('saveAudioSettings').onclick=async()=>{const oldMic=state.media.micId;state.media.micId=$('micSelect').value;state.media.speakerId=$('speakerSelect').value;state.media.outputVolume=Number($('outputVolume').value);state.media.voiceThreshold=Number($('voiceThreshold').value);state.media.echoCancellation=$('echoCancellation').checked;state.media.noiseSuppression=$('noiseSuppression').checked;state.media.autoGainControl=$('autoGainControl').checked;state.media.autoMute=$('autoMute').checked;savePrefs();await refreshAllOutputs();if(state.voice.channelId&&oldMic!==state.media.micId)await switchMicrophoneInCall();closeModal();toast('Configurações de áudio salvas.')};
