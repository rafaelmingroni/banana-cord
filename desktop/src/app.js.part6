  const showAudio=async()=>{stopCameraTest();stopMicTest();activate('tabAudio');area.innerHTML=`<div class="settings-card"><div class="settings-card-head compact"><div><span class="settings-kicker">ENTRADA</span><h3>Microfone</h3><p>Escolha o dispositivo e faça um teste ouvindo sua própria gravação.</p></div></div><div class="settings-field"><label>Dispositivo de entrada</label><select id="micSelect"><option>Carregando…</option></select></div><div class="mic-test-box"><div class="mic-test-copy"><b>Teste do microfone</b><small id="micTestState">Grave uma frase e depois ouça exatamente como seu microfone está saindo.</small></div><div class="mic-meter"><span id="micLevelBar"></span></div><div class="mic-test-actions"><button class="secondary" id="testMicBtn">● Gravar teste</button><button class="secondary hidden" id="playMicBtn">▶ Ouvir gravação</button></div></div><div class="settings-field"><label>Sensibilidade da voz <span id="thresholdLabel">${state.media.voiceThreshold}</span></label><input id="voiceThreshold" type="range" min="3" max="45" step="1" value="${state.media.voiceThreshold}"><small>Controla quando o contorno verde indica que você está falando.</small></div></div><div class="settings-card"><div class="settings-card-head compact"><div><span class="settings-kicker">PROCESSAMENTO</span><h3>Tratamento de voz</h3><p>Recursos leves do Chromium para deixar a conversa mais limpa.</p></div></div><div class="switch-grid"><label class="switch-line"><input id="echoCancellation" type="checkbox" ${state.media.echoCancellation?'checked':''}> Cancelamento de eco</label><label class="switch-line"><input id="noiseSuppression" type="checkbox" ${state.media.noiseSuppression?'checked':''}> Redução de ruído</label><label class="switch-line"><input id="autoGainControl" type="checkbox" ${state.media.autoGainControl?'checked':''}> Ganho automático</label><label class="switch-line"><input id="autoMute" type="checkbox" ${state.media.autoMute?'checked':''}> Entrar mutado</label></div></div><div class="settings-card"><div class="settings-card-head compact"><div><span class="settings-kicker">SAÍDA</span><h3>Fone / alto-falante</h3><p>Escolha onde ouvir as pessoas e os testes.</p></div></div><div class="settings-field"><label>Dispositivo de saída</label><select id="speakerSelect"><option>Carregando…</option></select></div><div class="settings-field"><label>Volume geral <span id="volumeLabel">${Math.round(state.media.outputVolume*100)}%</span></label><input id="outputVolume" type="range" min="0" max="1" step="0.01" value="${state.media.outputVolume}"></div><div class="settings-actions"><button class="secondary" id="testSpeakerBtn">🔊 Testar saída</button><button class="secondary" id="refreshDevicesBtn">↻ Atualizar dispositivos</button><button class="action" id="saveAudioSettings">Salvar áudio</button></div></div>`;const load=async()=>{try{const d=await enumerateMediaDevices(true);fillDeviceSelect($('micSelect'),d,'audioinput',state.media.micId,'Microfone');fillDeviceSelect($('speakerSelect'),d,'audiooutput',state.media.speakerId,'Saída')}catch{toast('Não consegui listar os dispositivos.')}};await load();$('testMicBtn').onclick=()=>micTest.recorder?.state==='recording'?finishMicRecording():startMicTest();$('playMicBtn').onclick=playMicRecording;$('testSpeakerBtn').onclick=testSpeaker;$('refreshDevicesBtn').onclick=load;$('voiceThreshold').oninput=e=>$('thresholdLabel').textContent=e.target.value;$('outputVolume').oninput=async e=>{state.media.outputVolume=Number(e.target.value);$('volumeLabel').textContent=`${Math.round(state.media.outputVolume*100)}%`;if(micTest.audio)micTest.audio.volume=state.media.outputVolume;await refreshAllOutputs()};$('saveAudioSettings').onclick=async()=>{const oldMic=state.media.micId;state.media.micId=$('micSelect').value;state.media.speakerId=$('speakerSelect').value;state.media.outputVolume=Number($('outputVolume').value);state.media.voiceThreshold=Number($('voiceThreshold').value);state.media.echoCancellation=$('echoCancellation').checked;state.media.noiseSuppression=$('noiseSuppression').checked;state.media.autoGainControl=$('autoGainControl').checked;state.media.autoMute=$('autoMute').checked;savePrefs();stopMicTest();await refreshAllOutputs();if(state.voice.channelId&&oldMic!==state.media.micId)await switchMicrophoneInCall();toast('Configurações de áudio salvas.');showAudio()}};
  const showVideo=async()=>{stopMicTest();activate('tabVideo');area.innerHTML=`<div class="settings-card"><div class="settings-card-head compact"><div><span class="settings-kicker">CÂMERA</span><h3>Vídeo</h3><p>Use qualidade alta quando quiser; durante jogos, 720p/30 costuma consumir menos.</p></div></div><div class="settings-field"><label>Câmera</label><select id="cameraSelect"><option>Carregando…</option></select></div><div class="settings-2col"><div class="settings-field"><label>Qualidade</label><select id="cameraQuality"><option value="480">480p</option><option value="720">720p</option><option value="1080">1080p</option></select></div><div class="settings-field"><label>FPS</label><select id="cameraFps"><option value="30">30 FPS</option><option value="60">60 FPS</option></select></div></div><button class="secondary" id="testCameraBtn">📹 Testar câmera</button><video id="cameraPreview" class="camera-preview" autoplay muted playsinline></video></div><div class="settings-card"><div class="settings-card-head compact"><div><span class="settings-kicker">COMPARTILHAMENTO</span><h3>Tela</h3><p>O modo automático tenta equilibrar nitidez e estabilidade sem pesar no jogo.</p></div></div><div class="settings-field"><label>Perfil</label><select id="streamPreset"><option value="auto">Automático (recomendado)</option><option value="quality">Qualidade</option><option value="smooth">Fluidez</option><option value="economy">Economia de banda</option></select></div><div class="settings-2col"><div class="settings-field"><label>Qualidade da tela</label><select id="screenQuality"><option value="720">720p</option><option value="1080">1080p</option></select></div><div class="settings-field"><label>FPS da tela</label><select id="screenFps"><option value="30">30 FPS</option><option value="60">60 FPS</option></select></div></div><div class="switch-grid"><label class="switch-line"><input id="autoFocusShare" type="checkbox" ${state.ui.autoFocusShare?'checked':''}> Focar tela compartilhada</label><label class="switch-line"><input id="showStats" type="checkbox" ${state.ui.showStats?'checked':''}> Mostrar ping/bitrate</label></div><div class="settings-help">Quando você compartilha a tela, o Banana Cord prioriza o stream e deixa de enviar sua webcam junto, reduzindo CPU e upload.</div><div class="settings-actions"><button class="action" id="saveVideoSettings">Salvar vídeo e tela</button></div></div>`;try{const d=await enumerateMediaDevices(false);fillDeviceSelect($('cameraSelect'),d,'videoinput',state.media.cameraId,'Câmera')}catch{}$('cameraQuality').value=state.media.cameraQuality;$('cameraFps').value=String(state.media.cameraFps);$('screenQuality').value=state.media.screenQuality;$('screenFps').value=String(state.media.screenFps);$('streamPreset').value=state.media.streamPreset;$('testCameraBtn').onclick=()=>cameraTest.stream?stopCameraTest():startCameraTest();$('saveVideoSettings').onclick=()=>{state.media.cameraId=$('cameraSelect').value;state.media.cameraQuality=$('cameraQuality').value;state.media.cameraFps=Number($('cameraFps').value);state.media.screenQuality=$('screenQuality').value;state.media.screenFps=Number($('screenFps').value);state.media.streamPreset=$('streamPreset').value;state.ui.autoFocusShare=$('autoFocusShare').checked;state.ui.showStats=$('showStats').checked;savePrefs();stopCameraTest();refreshStatsVisibility();toast('Configurações de vídeo salvas.')}};
  const showGeneral=()=>{stopMicTest();stopCameraTest();activate('tabGeneral');area.innerHTML=`<div class="settings-card"><div class="settings-card-head compact"><div><span class="settings-kicker">CHAMADAS</span><h3>Comportamento</h3><p>Preferências simples para entrar e sair de calls.</p></div></div><div class="switch-grid"><label class="switch-line"><input id="joinLeaveSounds" type="checkbox" ${state.ui.joinLeaveSounds?'checked':''}> Sons de entrada/saída</label><label class="switch-line"><input id="pttEnabled" type="checkbox" ${state.ui.pttEnabled?'checked':''}> Push-to-talk</label></div><div class="settings-field"><label>Tecla do push-to-talk</label><button class="secondary key-capture" id="capturePttKey">${escapeHtml(prettyKey(state.ui.pttKey))}</button></div><div class="settings-help"><b>Atalhos globais durante o jogo</b><br>Ctrl+Shift+M → mute · Ctrl+Shift+D → ensurdecer · Ctrl+Shift+S → compartilhar tela.</div><div class="settings-actions"><button class="action" id="saveGeneral">Salvar geral</button></div></div>`;$('capturePttKey').onclick=()=>{const btn=$('capturePttKey');btn.textContent='Pressione uma tecla…';const handler=e=>{e.preventDefault();state.ui.pttKey=e.code;btn.textContent=prettyKey(e.code);window.removeEventListener('keydown',handler,true)};window.addEventListener('keydown',handler,true)};$('saveGeneral').onclick=()=>{state.ui.joinLeaveSounds=$('joinLeaveSounds').checked;state.ui.pttEnabled=$('pttEnabled').checked;savePrefs();applyMicTrackState();toast('Configurações gerais salvas.')}};
  const showDiag=()=>{stopMicTest();stopCameraTest();activate('tabDiag');area.innerHTML=`<div class="settings-card"><div class="settings-card-head compact"><div><span class="settings-kicker">REDE</span><h3>Diagnóstico da chamada</h3><p>Use esta tela para separar problema de dispositivo de problema de conexão.</p></div></div>${diagnosticsHtml()}</div>`;$('refreshDiag').onclick=showDiag;$('reconnectVoice').onclick=async()=>{await reconnectCurrentVoice();showDiag()}};
