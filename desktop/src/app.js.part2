function connectTo(url,name,pendingInvite=''){localStorage.setItem('banana.name',name);localStorage.setItem('banana.serverUrl',url);state.serverUrl=url;state.pendingInvite=pendingInvite;els.hostBtn.disabled=true;els.connectBtn.disabled=true;els.connectBtn.textContent='Conectando…';state.socket?.disconnect();const socket=io(url,{transports:['websocket','polling'],reconnection:true,reconnectionAttempts:Infinity,reconnectionDelay:700,reconnectionDelayMax:4000,timeout:10000});state.socket=socket;socket.on('connect',()=>{setConnection(true);socket.emit('auth:hello',{deviceId:state.deviceId,name,avatar:ls('avatar'),status:state.ui.status})});socket.on('disconnect',()=>setConnection(false));socket.on('connect_error',()=>{setConnection(false);els.hostBtn.disabled=false;els.connectBtn.disabled=false;els.connectBtn.textContent='Entrar no Banana Cord';toast('Não consegui conectar. Verifique se o host está com o Banana Cord aberto.',4000)});bindSocket(socket)}

function bindSocket(socket){
  socket.on('auth:ready',async data=>{
    const wasReady=state.readyOnce;state.readyOnce=true;state.user=data.user;state.servers=data.servers||[];els.setup.classList.add('hidden');els.app.classList.remove('hidden');els.hostBtn.disabled=false;els.connectBtn.disabled=false;els.connectBtn.textContent='Entrar no Banana Cord';renderSelf();renderServers();startPing();socket.emit('dm:conversations:get');
    if(state.pendingInvite){const code=state.pendingInvite;state.pendingInvite='';socket.emit('server:join',{inviteCode:code})}
    else if(!state.selectedServer&&state.servers[0])selectServer(state.servers[0].id);else if(state.selectedServer){state.selectedServer=state.servers.find(s=>s.id===state.selectedServer.id)||state.servers[0]||null;if(state.selectedServer){renderChannels();socket.emit('members:get',{serverId:state.selectedServer.id})}}
    else if(!state.servers[0])showEmpty();
    if(wasReady&&state.voice.channelId&&state.voice.localAudio)await rejoinVoiceTransport();
  });
  socket.on('app:error',m=>toast(m,4200));
  socket.on('profile:updated',u=>{state.user=u;localStorage.setItem('banana.name',u.name);localStorage.setItem('banana.avatar',u.avatar||'');state.ui.status=u.status||state.ui.status;savePrefs();renderSelf();renderMembers();renderChannels()});
  socket.on('server:created',s=>{upsertServer(s);renderServers();selectServer(s.id);closeModal();toast(`Servidor ${s.name} criado.`)});
  socket.on('server:joined',s=>{upsertServer(s);renderServers();selectServer(s.id);closeModal();toast(`Você entrou em ${s.name}.`)});
  socket.on('server:removed',({serverId})=>{state.servers=state.servers.filter(s=>s.id!==serverId);if(state.selectedServer?.id===serverId){state.selectedServer=null;showEmpty()}renderServers();toast('Você foi removido desse servidor.')});
  socket.on('server:updated',s=>{upsertServer(s);if(state.selectedServer?.id===s.id){state.selectedServer=s;els.serverName.textContent=s.name;renderChannels();renderMembers()}renderServers()});
  socket.on('members:list',({serverId,members})=>{if(state.selectedServer?.id!==serverId)return;state.members=new Map((members||[]).map(m=>[m.id,m]));renderMembers();renderMessages();renderChannels()});
  socket.on('presence:update',u=>{let changed=false;if(state.members.has(u.id)){const old=state.members.get(u.id);state.members.set(u.id,{...old,...u});changed=true}const conv=state.dmConversations.find(c=>c.user?.id===u.id);if(conv){conv.user={...conv.user,...u};changed=true}if(changed){updatePresenceUser(u);renderMembers();if(state.viewMode==='dm'){renderDmSidebar();if(state.activeDmUserId===u.id)renderDmMessages()}else{renderMessages();renderChannels()}}});
  socket.on('voice:snapshot',({serverId,entries})=>{if(state.selectedServer?.id!==serverId)return;state.voicePresence=new Map();for(const e of entries||[]){const arr=state.voicePresence.get(e.channelId)||[];arr.push(e);state.voicePresence.set(e.channelId,arr)}renderChannels()});
  socket.on('voice:speaking-global',({socketId,userId,channelId,speaking})=>{const arr=state.voicePresence.get(channelId)||[];const e=arr.find(x=>x.socketId===socketId||x.user?.id===userId);if(e)e.speaking=!!speaking;renderChannels()});
  socket.on('voice:media-state-global',({socketId,userId,channelId,mediaState})=>{const arr=state.voicePresence.get(channelId)||[];const e=arr.find(x=>x.socketId===socketId||x.user?.id===userId);if(e)e.mediaState={...e.mediaState,...mediaState};renderChannels()});
  socket.on('voice:presence-event',({type,userId,channelId})=>{if(userId===state.user?.id)return;if(state.voice.channelId===channelId&&state.ui.joinLeaveSounds)playEventTone(type)});
  socket.on('messages:list',({channelId,messages})=>{state.messagesByChannel.set(channelId,messages||[]);if(state.selectedChannel?.id===channelId)renderMessages()});
  socket.on('message:new',m=>{const arr=state.messagesByChannel.get(m.channelId)||[];arr.push(m);state.messagesByChannel.set(m.channelId,arr.slice(-150));if(state.selectedChannel?.id===m.channelId)renderMessages(true)});
  socket.on('dm:conversations',({conversations})=>{state.dmConversations=Array.isArray(conversations)?conversations:[];if(state.viewMode==='dm')renderDmSidebar();updateDmUnreadBadge()});
  socket.on('dm:list',({user,messages})=>{if(!user?.id)return;mergeDmConversation(user,null);state.dmMessages.set(user.id,Array.isArray(messages)?messages:[]);if(state.viewMode==='dm'&&state.activeDmUserId===user.id)renderDmMessages(true)});
  socket.on('dm:new',({message,from,to})=>{if(!message)return;const me=state.user?.id;const peer=message.fromId===me?to:from;const peerId=peer?.id||(message.fromId===me?message.toId:message.fromId);if(!peerId)return;const arr=state.dmMessages.get(peerId)||[];if(!arr.some(x=>x.id===message.id))arr.push(message);state.dmMessages.set(peerId,arr.slice(-200));mergeDmConversation(peer||{id:peerId,name:'Amigo'},message);const open=state.viewMode==='dm'&&state.activeDmUserId===peerId;if(!open&&message.fromId!==me){state.dmUnread.add(peerId);toast(`Nova mensagem de ${peer?.name||'um amigo'}.`,3200)}else if(open){state.dmUnread.delete(peerId)}updateDmUnreadBadge();if(state.viewMode==='dm'){renderDmSidebar();if(open)renderDmMessages(true)}});
  socket.on('voice:full',()=>{cleanupVoice();toast('Essa sala já está com 5 pessoas.')});
  socket.on('voice:peers',async({channelId,peers})=>{if(state.voice.channelId!==channelId)return;for(const p of peers)await createPeer(p.socketId,p.user,true,p.mediaState||{});updateVoiceUI();startPeerStats();emitMediaState()});
  socket.on('voice:user-joined',async({socketId,user,mediaState})=>{if(state.voice.channelId&&!state.voice.peers.has(socketId))await createPeer(socketId,user,false,mediaState||{});updateVoiceUI();emitMediaState()});
  socket.on('voice:user-left',({socketId})=>removePeer(socketId));
  socket.on('voice:media-state',({socketId,mediaState})=>updatePeerMediaState(socketId,mediaState||{}));
  socket.on('voice:speaking',({socketId,speaking})=>{const p=state.voice.peers.get(socketId);if(!p)return;p.speaking=!!speaking;setCardSpeaking(`video-${socketId}`,p.speaking&&!p.mediaState?.muted)});
  socket.on('webrtc:signal',async({fromSocketId,fromUser,data})=>handleSignal(fromSocketId,fromUser,data));
}

function updatePresenceUser(u){for(const arr of state.voicePresence.values())for(const e of arr)if(e.user?.id===u.id)e.user={...e.user,...u};for(const p of state.voice.peers.values())if(p.user?.id===u.id){p.user={...p.user,...u};addRemoteCard(p)}}
function upsertServer(s){const i=state.servers.findIndex(x=>x.id===s.id);if(i>=0)state.servers[i]=s;else state.servers.push(s)}
function showEmpty(){state.selectedServer=null;state.selectedChannel=null;state.viewMode='server';state.activeDmUserId=null;els.app.classList.remove('dm-mode');els.serverName.textContent='Banana Cord';els.channels.innerHTML='';els.memberList.innerHTML='';els.emptyView.innerHTML='<div class="big-banana">🍌</div><h2>Banana Cord</h2><p>Crie ou entre em um servidor pelo botão +.</p>';els.emptyView.classList.remove('hidden');els.textView.classList.add('hidden');els.voiceView.classList.add('hidden');els.inviteBtn.style.visibility='hidden';els.serverSettingsBtn.style.visibility='hidden';renderServers()}
function renderServers(){els.homeServer?.classList.toggle('active',state.viewMode==='dm');els.serverList.innerHTML='';for(const s of state.servers){const b=document.createElement('button');b.className='server-icon'+(state.viewMode==='server'&&state.selectedServer?.id===s.id?' active':'');b.title=s.name;b.textContent=s.name.trim().slice(0,2).toUpperCase();b.addEventListener('click',()=>selectServer(s.id));els.serverList.appendChild(b)}}
function selectServer(id){if(state.voice.serverId&&state.voice.serverId!==id)leaveVoice();const s=state.servers.find(x=>x.id===id);if(!s)return;state.viewMode='server';state.activeDmUserId=null;els.app.classList.remove('dm-mode');state.selectedServer=s;els.serverName.textContent=s.name;els.inviteBtn.style.visibility='visible';els.serverSettingsBtn.style.visibility='visible';state.voicePresence=new Map();renderServers();renderChannels();state.socket.emit('members:get',{serverId:s.id});const firstText=s.channels.find(c=>c.type==='text');if(firstText)selectChannel(firstText.id);else{els.emptyView.classList.remove('hidden');els.textView.classList.add('hidden');els.voiceView.classList.add('hidden')}}

function renderChannels(){
  const s=state.selectedServer;els.channels.innerHTML='';if(!s)return;const manage=can('moderator');
  for(const type of ['text','voice']){
    const wrap=document.createElement('div');wrap.className='channel-section';const title=document.createElement('div');title.className='channel-section-title';title.innerHTML=`<span>${type==='text'?'Canais de texto':'Canais de voz'}</span>`;
    if(manage){const plus=document.createElement('button');plus.className='channel-add';plus.textContent='+';plus.title='Criar canal';plus.addEventListener('click',()=>channelModal(type));title.appendChild(plus)}wrap.appendChild(title);
    for(const c of s.channels.filter(x=>x.type===type)){
      const row=document.createElement('div');row.className='channel-row';row.dataset.channelId=c.id;row.draggable=manage;
      const b=document.createElement('button');b.className='channel'+(state.selectedChannel?.id===c.id?' active':'');b.innerHTML=`<span class="symbol">${type==='text'?'#':'🔊'}</span><span>${escapeHtml(c.name)}</span>`;b.addEventListener('click',()=>selectChannel(c.id));row.appendChild(b);
      if(manage){const actions=document.createElement('div');actions.className='channel-actions';const more=document.createElement('button');more.className='channel-more';more.title='Editar canal';more.textContent='⋯';more.addEventListener('click',e=>{e.stopPropagation();editChannelModal(c)});actions.appendChild(more);row.appendChild(actions);wireChannelDrag(row,c)}
      wrap.appendChild(row);
      if(type==='voice')renderVoiceUsers(wrap,c.id);
    }
    els.channels.appendChild(wrap);
  }
}
