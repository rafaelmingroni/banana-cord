.update-badge{margin-left:auto;background:#2f6f45;border:1px solid #4b9964;color:#f2fff5;border-radius:7px;padding:5px 9px;font-size:11px;font-weight:800;cursor:pointer;white-space:nowrap}.update-badge.ready{background:#f0b90b;border-color:#ffd34f;color:#201a00}.update-settings .update-version{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:8px}.update-version>div{background:#181a1d;border:1px solid #35383d;border-radius:9px;padding:11px}.update-version small{font-size:9px;color:#8f949d;letter-spacing:.06em;margin:0 0 4px}.update-version b{display:block;font-size:18px}.update-status{background:#181a1d;border:1px solid #383b40;border-radius:9px;padding:11px;margin:14px 0 4px}.update-status b{display:block;margin-bottom:3px}.update-status small{margin:0;color:#9ea2aa}.update-progress{height:7px;border-radius:999px;background:#0f1012;overflow:hidden;margin-top:9px}.update-progress span{height:100%;display:block;background:var(--accent);transition:width .2s ease}.update-settings>input{width:100%;box-sizing:border-box}
@media(max-width:700px){.update-settings .update-version{grid-template-columns:1fr}.update-badge{max-width:120px;overflow:hidden;text-overflow:ellipsis}}

/* Banana Cord v0.10 - visual, configurações e mensagens privadas */
.home-server{position:relative;display:grid;place-items:center}.home-banana{font-size:25px;line-height:1}.dm-unread-badge{position:absolute;right:-2px;top:-3px;min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:#da373c;color:white;border:2px solid #0d0e10;display:grid;place-items:center;font-size:9px;font-weight:900}.app.dm-mode{grid-template-columns:72px 250px minmax(420px,1fr)}.app.dm-mode .members{display:none}.dm-sidebar{display:grid;gap:9px}.dm-new-btn{width:100%;padding:9px 10px;border-radius:8px;background:#24262a;color:#d9dbe0;text-align:left;font-weight:700}.dm-new-btn:hover{background:#2d3035;color:white}.dm-conversation-list{display:grid;gap:3px}.dm-row{width:100%;display:grid;grid-template-columns:36px minmax(0,1fr) auto;align-items:center;gap:9px;padding:7px;border-radius:9px;background:transparent;color:#d7d9dd;text-align:left}.dm-row:hover,.dm-row.active{background:#292c31}.dm-row .avatar{width:36px;height:36px;font-size:12px}.dm-row-text{min-width:0;display:grid;gap:2px}.dm-row-text b,.dm-row-text small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dm-row-text b{font-size:12px}.dm-row-text small{font-size:10px;color:#858a94}.dm-row-meta{display:flex;align-items:center;gap:3px}.dm-unread-dot{width:8px;height:8px;border-radius:50%;background:var(--yellow);box-shadow:0 0 0 3px #f3c6231c}.dm-empty-list{color:#727782;font-size:11px;padding:13px 8px}.dm-picker{display:grid;gap:6px;margin-top:12px}.dm-picker-row{width:100%!important;margin:0!important;display:grid!important;grid-template-columns:40px 1fr!important;gap:10px!important;align-items:center!important;text-align:left!important;background:#181a1d!important;color:#e8e9ec!important;border:1px solid #34373c!important}.dm-picker-row:hover{background:#23262b!important;border-color:#494d54!important}.dm-picker-row .avatar{width:38px;height:38px}.dm-picker-row span:last-child{display:grid;gap:2px}.dm-picker-row small{font-size:10px}.dm-conversation-empty{min-height:220px;display:grid;place-content:center;text-align:center;gap:6px;color:#8e939d}.dm-conversation-empty b{color:#eceef1;font-size:18px}.dm-conversation-empty span{font-size:12px}.dm-message .msg-head b{color:#f0cf50}.simple-modal-head p{margin-top:-7px}

.settings-modal{width:min(900px,94vw)!important;max-height:90vh!important;padding:0!important;overflow:hidden!important;border-radius:18px!important;background:#17181b!important;box-shadow:0 28px 90px #000b!important}.settings-modal .modal-close{z-index:6;right:15px;top:13px;width:34px;height:34px;display:grid;place-items:center;border-radius:50%;background:#24262a;color:#9fa4ad;font-size:22px}.settings-modal .modal-close:hover{background:#31343a;color:white}.settings-shell{display:grid;grid-template-columns:210px minmax(0,1fr);min-height:min(680px,86vh);max-height:86vh}.settings-nav{background:#111214;border-right:1px solid #292b30;padding:20px 12px 14px;display:flex;flex-direction:column;min-height:0}.settings-brand{display:flex;align-items:center;gap:10px;padding:0 8px 18px;border-bottom:1px solid #292b30;margin-bottom:12px}.settings-banana{width:38px;height:38px;border-radius:12px;background:#2c2711;display:grid;place-items:center;font-size:24px}.settings-brand div:last-child{display:grid;gap:1px}.settings-brand b{font-size:13px}.settings-brand small{font-size:10px;color:#777d87}.settings-nav-list{display:grid;gap:4px}.settings-nav-item{width:100%!important;margin:0!important;padding:10px 11px!important;display:grid!important;grid-template-columns:24px 1fr!important;align-items:center!important;gap:8px!important;background:transparent!important;color:#9ba0aa!important;border:1px solid transparent!important;border-radius:9px!important;text-align:left!important;font-weight:600!important}.settings-nav-item span{font-size:15px;opacity:.85}.settings-nav-item b{font-size:12px}.settings-nav-item:hover{background:#1e2024!important;color:#eceef1!important}.settings-nav-item.active{background:#2b2818!important;color:#ffe36b!important;border-color:#4f4722!important}.settings-nav-foot{margin-top:auto;padding:14px 10px 2px;color:#626873;font-size:10px}.settings-content{min-width:0;overflow:auto;padding:28px 32px 34px;background:linear-gradient(180deg,#1c1e22 0,#181a1d 160px)}.settings-content-head{padding-right:40px;margin-bottom:20px}.settings-content-head>span,.settings-kicker{display:block;color:#8a909a;font-size:9px;letter-spacing:.12em;font-weight:900;margin-bottom:4px}.settings-content-head h2{margin:0 0 4px;font-size:25px;letter-spacing:-.02em}.settings-content-head p{margin:0;color:#8e949e;font-size:12px}.settings-card{background:#202226;border:1px solid #32353b;border-radius:14px;padding:18px;margin-bottom:13px;box-shadow:0 8px 28px #0002}.settings-card-muted{background:#1a1c20}.settings-card-head{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-bottom:16px}.settings-card-head.compact{margin-bottom:13px}.settings-card-head h3{margin:0 0 4px;font-size:16px}.settings-card-head p{margin:0;color:#8f949d;font-size:11px;line-height:1.45}.settings-avatar{width:64px;height:64px;font-size:22px;box-shadow:0 0 0 4px #15171a,0 0 0 5px #363940}.settings-form-grid,.settings-2col{display:grid;grid-template-columns:1fr 1fr;gap:12px}.settings-field{min-width:0;margin-top:11px}.settings-field:first-child{margin-top:0}.settings-field label,.settings-card>label{display:flex;justify-content:space-between;align-items:center;margin:0 0 7px;font-size:10px;letter-spacing:.06em;color:#aeb3bc}.settings-field input:not([type=range]),.settings-field select,.settings-card select,.settings-card input:not([type=checkbox]):not([type=range]){width:100%;background:#15171a;border:1px solid #363a40;color:#f1f2f4;border-radius:9px;padding:10px 11px;outline:none}.settings-field input:focus,.settings-field select:focus,.settings-card select:focus,.settings-card input:focus{border-color:#7a6920;box-shadow:0 0 0 2px #f3c62312}.settings-field small{display:block;color:#737985;font-size:10px;margin-top:6px}.settings-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}.settings-actions button,.settings-card button.secondary,.settings-card button.action{width:auto!important;min-width:118px;margin:0!important;padding:9px 13px!important;border-radius:8px!important}.settings-card button.secondary{background:#2b2e33!important;color:#d8dbe0!important;border:1px solid #41454c!important}.settings-card button.secondary:hover{background:#34383e!important}.settings-card button.action{background:var(--yellow)!important;color:#201b04!important}.settings-url{word-break:break-all!important}.mic-test-box{margin-top:12px;background:#17191c;border:1px solid #34373d;border-radius:12px;padding:13px}.mic-test-copy{display:grid;gap:3px}.mic-test-copy b{font-size:12px}.mic-test-copy small{font-size:10px;color:#858b95;line-height:1.4}.mic-test-actions{display:flex;gap:8px;margin-top:10px}.mic-test-actions button{flex:1!important}.mic-meter{height:9px;background:#0f1012;border:0;border-radius:999px;overflow:hidden;margin:12px 0 0}.mic-meter span{display:block;width:0;height:100%;background:linear-gradient(90deg,#2fbf68 0%,#57d97f 70%,#f3c623 100%);transition:width .045s linear}.switch-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0}.switch-line{display:flex!important;align-items:center!important;gap:9px!important;padding:10px 11px!important;margin:0!important;border:1px solid #363940!important;border-radius:10px!important;background:#191b1f!important;color:#cfd2d7!important;text-transform:none!important;letter-spacing:0!important;font-size:11px!important;font-weight:650!important}.switch-line:hover{border-color:#464a52!important;background:#1e2024!important}.switch-line input{width:auto!important;margin:0!important;accent-color:var(--yellow)}.settings-help{padding:11px 12px;border-radius:10px;background:#181a1e;border:1px solid #33363c;color:#9298a2;font-size:11px;line-height:1.5;margin-top:12px}.settings-help b{color:#cfd2d8}.key-capture{width:100%!important}.camera-preview{width:100%;max-height:280px;background:#0d0e10;border:1px solid #34373d;border-radius:12px;margin-top:12px;object-fit:contain}.diagnostics{display:grid;gap:8px}.diag-row{display:grid;grid-template-columns:130px minmax(0,1fr);align-items:center;gap:12px;background:#191b1f;border:1px solid #34373d;border-radius:10px;padding:10px 12px}.diag-row b{font-size:11px}.diag-row span{color:#9ca2ac;font-size:10px;word-break:break-word}.update-version{display:grid;grid-template-columns:1fr 1fr;gap:10px}.update-version>div{background:#17191c!important;border:1px solid #34373d!important;border-radius:11px!important;padding:12px!important}.update-status{background:#17191c!important;border-color:#34373d!important;border-radius:11px!important}.update-progress{background:#0d0e10!important}.update-progress span{background:linear-gradient(90deg,#d8ad0b,#ffe15a)!important}

@media(max-width:900px){.settings-modal{width:min(760px,95vw)!important}.settings-shell{grid-template-columns:170px minmax(0,1fr)}.settings-content{padding:24px 22px 30px}.settings-form-grid,.settings-2col,.switch-grid{grid-template-columns:1fr}.app.dm-mode{grid-template-columns:66px 230px minmax(380px,1fr)}}
@media(max-width:700px){.settings-shell{grid-template-columns:1fr}.settings-nav{border-right:0;border-bottom:1px solid #292b30;padding:12px}.settings-brand{display:none}.settings-nav-list{display:flex;overflow-x:auto}.settings-nav-item{min-width:max-content!important;grid-template-columns:20px auto!important}.settings-nav-foot{display:none}.settings-content{padding:20px}.settings-content-head{padding-right:32px}.mic-test-actions,.settings-actions{flex-direction:column}.mic-test-actions button,.settings-actions button{width:100%!important}.update-version{grid-template-columns:1fr}.app.dm-mode{grid-template-columns:62px 210px minmax(320px,1fr)}}
