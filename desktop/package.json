{
  "name": "banana-cord",
  "version": "1.0.1",
  "description": "Banana Cord v1.0.1 - correções de estabilidade, desempenho e usabilidade",
  "private": true,
  "main": "updater-prompt.js",
  "author": "Rafael Mingroni",
  "scripts": {
    "prepare:source": "node scripts/merge-source.js",
    "prestart": "npm run prepare:source",
    "start": "electron .",
    "predist:win": "npm run prepare:source && npm run smoke:ui",
    "dist:win": "electron-builder --win nsis",
    "predist:portable": "npm run prepare:source && npm run smoke:ui",
    "dist:portable": "electron-builder --win portable",
    "smoke:v1": "node scripts/smoke-v1.js",
    "smoke:ui": "node scripts/smoke-ui.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bananacord.app",
    "productName": "Banana Cord",
    "artifactName": "Banana-Cord-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "tray.js",
      "updater-prompt.js",
      "main.js",
      "src/**/*",
      "server/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/banana-cord.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Banana Cord"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rafaelmingroni",
        "repo": "banana-cord",
        "releaseType": "release"
      }
    ]
  }
}
