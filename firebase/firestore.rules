rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function member(serverId) { return verified() && exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)); }
    function role(serverId) { return get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data.role; }
    function owner(serverId) { return verified() && get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid; }
    function ownerAfter(serverId) { return verified() && getAfter(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid; }
    function admin(serverId) { return member(serverId) && (owner(serverId) || role(serverId) == 'owner' || role(serverId) == 'admin'); }
    function moderator(serverId) { return member(serverId) && (owner(serverId) || role(serverId) == 'owner' || role(serverId) == 'admin' || role(serverId) == 'moderator'); }
    function validInvite(serverId, code) {
      return verified() && code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.serverId == serverId
        && (!('expiresAt' in get(/databases/$(database)/documents/invites/$(code)).data)
            || get(/databases/$(database)/documents/invites/$(code)).data.expiresAt > request.time);
    }
    function channelAccess(serverId, channelId) {
      let ch = get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)).data;
      let r = role(serverId);
      return member(serverId) && (!('allowedRoles' in ch) || ch.allowedRoles.size() == 0 || r == 'owner' || r == 'admin' || r in ch.allowedRoles);
    }
    function validText(value) { return value is string && value.size() > 0 && value.size() <= 2000; }
    function validDisplayName(value) { return value is string && value.size() > 0 && value.size() <= 32; }
    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'avatar', 'customStatus', 'updatedAt', 'searchName'])
        && (!('displayName' in data) || validDisplayName(data.displayName))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 800000))
        && (!('customStatus' in data) || (data.customStatus is string && data.customStatus.size() <= 80))
        && (!('searchName' in data) || (data.searchName is string && data.searchName.size() <= 32));
    }
    function relationForThread(threadId) {
      return get(/databases/$(database)/documents/relationships/$(threadId));
    }
    function friendThread(threadId) {
      return verified()
        && exists(/databases/$(database)/documents/relationships/$(threadId))
        && relationForThread(threadId).data.status == 'friends'
        && request.auth.uid in relationForThread(threadId).data.participants;
    }
    function dmMember(threadId) {
      return verified()
        && exists(/databases/$(database)/documents/dmThreads/$(threadId))
        && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants;
    }
    function dmMemberAfter(threadId) {
      return verified() && request.auth.uid in getAfter(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants;
    }

    match /users/{uid} {
      allow read, create, update: if verified() && request.auth.uid == uid;
      allow delete: if false;
      match /serverRefs/{serverId} {
        allow read, create, update, delete: if verified() && request.auth.uid == uid;
        allow delete: if owner(serverId);
      }
    }

    match /publicProfiles/{uid} {
      // Exact-name search requires query access; writes stay self-only and schema-limited.
      allow read: if verified();
      allow create, update: if verified() && request.auth.uid == uid && validProfile(request.resource.data);
      allow delete: if false;
    }

    match /servers/{serverId} {
      // Server metadata is no longer readable by arbitrary authenticated accounts.
      allow get: if member(serverId);
      allow list: if false;
      allow create: if verified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow update: if admin(serverId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow update: if moderator(serverId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categories', 'updatedAt'])
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if owner(serverId);

      match /members/{uid} {
        allow read: if member(serverId) || (verified() && uid == request.auth.uid);
        allow create: if ownerAfter(serverId)
          || (verified() && uid == request.auth.uid
              && request.resource.data.role == 'member'
              && validInvite(serverId, request.resource.data.joinedVia));
        allow update: if owner(serverId);
        allow update: if verified() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatar', 'customStatus']);
        allow delete: if owner(serverId) || (verified() && uid == request.auth.uid);
      }

      match /channels/{channelId} {
        allow read: if member(serverId);
        allow create: if (ownerAfter(serverId) || moderator(serverId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 32
          && request.resource.data.type in ['text', 'voice'];
        allow update, delete: if moderator(serverId);

        match /messages/{messageId} {
          allow read: if channelAccess(serverId, channelId);
          allow create: if channelAccess(serverId, channelId)
            && request.resource.data.authorId == request.auth.uid
            && validText(request.resource.data.text)
            && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt', 'editedAt', 'replyToId', 'reactions', 'mentionIds']);

          // Authors/moderators may edit message content, but identity and creation metadata are immutable.
          allow update: if channelAccess(serverId, channelId)
            && (resource.data.authorId == request.auth.uid || moderator(serverId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'mentionIds'])
            && validText(request.resource.data.text);

          // Any authorized channel member may only mutate reactions.
          allow update: if channelAccess(serverId, channelId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);

          allow delete: if channelAccess(serverId, channelId)
            && (resource.data.authorId == request.auth.uid || moderator(serverId));
        }
      }
    }

    match /invites/{code} {
      // Exact invite lookup is allowed; enumerating the invite collection is not.
      allow get: if verified();
      allow list: if false;
      allow create: if verified()
        && (ownerAfter(request.resource.data.serverId) || admin(request.resource.data.serverId))
        && request.resource.data.code == code
        && code.size() >= 8
        && code.size() <= 16;
      allow update: if admin(resource.data.serverId)
        && request.resource.data.serverId == resource.data.serverId
        && request.resource.data.code == resource.data.code;
      allow delete: if admin(resource.data.serverId) || owner(resource.data.serverId);
    }

    match /relationships/{relationshipId} {
      allow read: if verified() && request.auth.uid in resource.data.participants;

      allow create: if verified()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && (
          (request.resource.data.status == 'pending' && request.resource.data.requestedBy == request.auth.uid)
          || (request.resource.data.status == 'blocked' && request.resource.data.blockedBy == request.auth.uid)
        );

      // Only the recipient of a pending request can turn it into friendship.
      allow update: if verified()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && resource.data.status == 'pending'
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.status == 'friends'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blockedBy', 'updatedAt']);

      // Either participant may block the relationship, but cannot rewrite the pair.
      allow update: if verified()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.status == 'blocked'
        && request.resource.data.blockedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blockedBy', 'updatedAt']);

      allow delete: if verified() && request.auth.uid in resource.data.participants;
    }

    match /dmThreads/{threadId} {
      // Existing participants can read old history, but new writes/calls require an accepted friendship.
      allow read: if verified() && request.auth.uid in resource.data.participants;
      allow create: if friendThread(threadId)
        && request.resource.data.participants == relationForThread(threadId).data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.keys().hasOnly(['participants', 'updatedAt', 'lastMessage', 'activeCall']);
      allow update: if dmMember(threadId)
        && friendThread(threadId)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage', 'activeCall']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if dmMember(threadId);
        allow create: if friendThread(threadId)
          && dmMemberAfter(threadId)
          && request.resource.data.fromId == request.auth.uid
          && request.resource.data.toId in getAfter(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants
          && request.resource.data.toId != request.auth.uid
          && validText(request.resource.data.text)
          && request.resource.data.keys().hasOnly(['fromId', 'toId', 'text', 'createdAt', 'editedAt', 'replyToId', 'reactions']);

        allow update: if friendThread(threadId)
          && dmMember(threadId)
          && resource.data.fromId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && validText(request.resource.data.text);

        allow update: if friendThread(threadId)
          && dmMember(threadId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);

        allow delete: if dmMember(threadId) && resource.data.fromId == request.auth.uid;
      }
    }
  }
}
