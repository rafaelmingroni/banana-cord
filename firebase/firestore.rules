rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function member(serverId) {
      return verified() && exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid));
    }
    function owner(serverId) {
      return verified() && get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid;
    }
    function ownerAfter(serverId) {
      return verified() && getAfter(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read, create, update: if verified() && request.auth.uid == uid;
      allow delete: if false;
      match /serverRefs/{serverId} {
        allow read, write: if verified() && request.auth.uid == uid;
      }
    }

    match /servers/{serverId} {
      allow create: if verified() && request.resource.data.ownerId == request.auth.uid;
      allow read: if member(serverId);
      allow update, delete: if owner(serverId);

      match /members/{uid} {
        allow read: if member(serverId);
        allow create: if verified() && ownerAfter(serverId);
        allow update, delete: if owner(serverId);
      }

      match /channels/{channelId} {
        allow read: if member(serverId);
        allow create: if ownerAfter(serverId);
        allow update, delete: if owner(serverId);

        match /messages/{messageId} {
          allow read: if member(serverId);
          allow create: if member(serverId) && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if member(serverId) && (resource.data.authorId == request.auth.uid || owner(serverId));
        }
      }
    }

    match /dmThreads/{threadId} {
      allow read: if verified() && request.auth.uid in resource.data.participants;
      allow create: if verified()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if verified()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if verified()
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants;
        allow create: if verified()
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if verified()
          && resource.data.authorId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(threadId)).data.participants;
      }
    }
  }
}
