rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function validImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    match /mingrx/community-icons/{uid}/{allPaths=**} {
      allow read: if verified();
      allow create, update: if verified()
        && request.auth.uid == uid
        && validImageUpload();
      allow delete: if verified() && request.auth.uid == uid;
    }

    match /mingrx/chat-media/{uid}/{allPaths=**} {
      allow read: if verified();
      allow create, update: if verified()
        && request.auth.uid == uid
        && validImageUpload();
      allow delete: if verified() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
